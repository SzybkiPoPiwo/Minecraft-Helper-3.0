<Window x:Class="MinecraftHelper.AutoReconnectProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Profil Auto Reconnect"
        Width="780"
        Height="840"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Background="{DynamicResource GlassBackdropBrush}"
        Foreground="{StaticResource GlassInkBrush}"
        FontFamily="{StaticResource GlassFont}"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4F566B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#8CFFFFFF" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource GlassIconTile}" Width="30" Height="30" CornerRadius="10" Margin="0,0,10,0">
                            <Viewbox Width="16" Height="16"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M20,11 A8,8 0 1 0 17.7,16.7 M20,5 V11 H14"/></Grid></Viewbox>
                        </Border>
                        <TextBlock Text="Profil serwera — powrót po reconnectcie" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource GlassIconButton}" HorizontalAlignment="Right" ToolTip="Zamknij" Click="BtnCancel_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,18,20,16">
                    <Border Style="{StaticResource GlassCard}" CornerRadius="20" Padding="20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Podstawowe informacje" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Nazwa profilu" Style="{StaticResource FieldLabel}"/>
                                <TextBox Name="TxtProfileName" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Adres Direct Connect" Style="{StaticResource FieldLabel}"/>
                                <TextBox Name="TxtServerAddress" Grid.Column="1" Style="{StaticResource GlassMonoBox}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Komenda domu" Style="{StaticResource FieldLabel}"/>
                                <TextBox Name="TxtHomeCommand" Grid.Column="1" Style="{StaticResource GlassMonoBox}"/>
                            </Grid>
                            <TextBlock Text="Bez GUI wpisz pełną komendę, np. /home kopalnia." Style="{StaticResource Hint}" Margin="185,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" CornerRadius="20" Padding="20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Powrót po pełnym reconnectcie" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Name="ChkHomeHasGui" Content="Komenda /home otwiera GUI z wyborem" Checked="ChkHomeHasGui_Changed" Unchecked="ChkHomeHasGui_Changed"/>

                            <StackPanel Name="PanelHomeGui" Margin="0,14,0,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Czekaj na GUI (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Name="TxtHomeGuiDelay" Grid.Column="1" Style="{StaticResource GlassMonoBox}"/>
                                    <TextBlock Grid.Column="2" Text="czas od wysłania /home" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Pole do kliknięcia:" FontWeight="SemiBold" Foreground="{StaticResource GlassInk2Brush}"/>
                                    <TextBlock Name="TxtSelectedSlot" Margin="8,0,0,0" FontWeight="Bold" Foreground="{DynamicResource GlassAccentInkBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Kliknij slot. Przyciski z prawej i na dole zmieniają rozmiar planszy." Style="{StaticResource Hint}" Margin="0,0,0,10"/>

                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Name="BorderHomeSlots" Background="#99FFFFFF" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1" CornerRadius="14" Padding="5">
                                        <UniformGrid Name="PanelHomeSlots"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Kolumny" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GlassInk2Brush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Button Content="+" Width="38" Margin="0,0,0,6" ToolTip="Dodaj kolumnę" Click="BtnAddColumn_Click"/>
                                        <Button Content="−" Width="38" ToolTip="Usuń kolumnę" Click="BtnRemoveColumn_Click"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Rzędy" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GlassInk2Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="−" Width="38" Margin="0,0,6,0" ToolTip="Usuń rząd" Click="BtnRemoveRow_Click"/>
                                        <Button Content="+" Width="38" ToolTip="Dodaj rząd" Click="BtnAddRow_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Name="TxtGridSize" FontSize="12" Foreground="{StaticResource GlassInk2Brush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" CornerRadius="20" Padding="20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox Name="ChkMissingPickaxeRecovery" Checked="ChkMissingPickaxeRecovery_Changed" Unchecked="ChkMissingPickaxeRecovery_Changed">
                                <StackPanel>
                                    <TextBlock Text="Brak diamentowego kilofa podczas Auto EQ" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Wróć do home i zakończ kopanie. Kontrola działa wyłącznie podczas zaplanowanego wyrzucania przedmiotów, nie otwiera dodatkowo EQ. Sprawdza 27 slotów oraz hotbar." Style="{StaticResource Hint}" FontWeight="Normal"/>
                                </StackPanel>
                            </CheckBox>

                            <StackPanel Name="PanelMissingPickaxeRecovery" Margin="0,16,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Komenda powrotu" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Name="TxtMissingPickaxeHomeCommand" Grid.Column="1" Style="{StaticResource GlassMonoBox}"/>
                                </Grid>
                                <TextBlock Text="Bez GUI wpisz pełną komendę, np. /home kopalnia. To ustawienie jest niezależne od powrotu po reconnectcie." Style="{StaticResource Hint}" Margin="185,0,0,14"/>

                                <CheckBox Name="ChkMissingPickaxeHomeHasGui" Content="Komenda powrotu otwiera GUI z wyborem" Checked="ChkMissingPickaxeHomeHasGui_Changed" Unchecked="ChkMissingPickaxeHomeHasGui_Changed"/>

                                <StackPanel Name="PanelMissingPickaxeHomeGui" Margin="0,14,0,0">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="185"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Czekaj na GUI (s)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Name="TxtMissingPickaxeHomeGuiDelay" Grid.Column="1" Style="{StaticResource GlassMonoBox}"/>
                                        <TextBlock Grid.Column="2" Text="czas od wysłania komendy" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Pole do kliknięcia:" FontWeight="SemiBold" Foreground="{StaticResource GlassInk2Brush}"/>
                                        <TextBlock Name="TxtMissingPickaxeSelectedSlot" Margin="8,0,0,0" FontWeight="Bold" Foreground="{DynamicResource GlassAccentInkBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Kliknij slot używany wyłącznie po wykryciu braku diamentowego kilofa." Style="{StaticResource Hint}" Margin="0,0,0,10"/>

                                    <Grid HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Name="BorderMissingPickaxeHomeSlots" Background="#99FFFFFF" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1" CornerRadius="14" Padding="5">
                                            <UniformGrid Name="PanelMissingPickaxeHomeSlots"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Kolumny" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GlassInk2Brush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <Button Content="+" Width="38" Margin="0,0,0,6" ToolTip="Dodaj kolumnę" Click="BtnMissingPickaxeAddColumn_Click"/>
                                            <Button Content="−" Width="38" ToolTip="Usuń kolumnę" Click="BtnMissingPickaxeRemoveColumn_Click"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Rzędy" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GlassInk2Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Content="−" Width="38" Margin="0,0,6,0" ToolTip="Usuń rząd" Click="BtnMissingPickaxeRemoveRow_Click"/>
                                            <Button Content="+" Width="38" ToolTip="Dodaj rząd" Click="BtnMissingPickaxeAddRow_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Name="TxtMissingPickaxeGridSize" FontSize="12" Foreground="{StaticResource GlassInk2Brush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" CornerRadius="20" Padding="20,18" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Czasy reconnectu" Style="{StaticResource SectionTitle}"/>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Po dołączeniu (s)" Style="{StaticResource GlassLabel}"/>
                                    <TextBox Name="TxtJoinDelay" Style="{StaticResource GlassMonoBox}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Teleport (s)" Style="{StaticResource GlassLabel}"/>
                                    <TextBox Name="TxtTeleportDelay" Style="{StaticResource GlassMonoBox}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Maks. prób" Style="{StaticResource GlassLabel}"/>
                                    <TextBox Name="TxtMaxAttempts" Style="{StaticResource GlassMonoBox}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Do czasu teleportu program dodaje 2 s buforu bezpieczeństwa." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Name="TxtValidation" Foreground="{StaticResource GlassBadBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#8CFFFFFF" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0">
                    <Button Content="Anuluj" MinWidth="105" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button Content="Zapisz profil" MinWidth="130" Style="{StaticResource GlassPrimaryButton}" Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
