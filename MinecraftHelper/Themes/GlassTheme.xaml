<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MinecraftHelper">
    <!--
        Jasny motyw glass wspólny dla Kopacza i Auto Clickera.
        Kolory akcentu (GlassAccent*) i tło (GlassBackdropBrush) pochodzą z GlassAccent*.xaml,
        dlatego są pobierane przez DynamicResource.
    -->
    <FontFamily x:Key="GlassFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="GlassMonoFont">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="GlassInkBrush" Color="#161A2B"/>
    <SolidColorBrush x:Key="GlassInk2Brush" Color="#4F566B"/>
    <SolidColorBrush x:Key="GlassLineBrush" Color="#17161A2B"/>
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="GlassSurface2Brush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="GlassFieldBrush" Color="#BFFFFFFF"/>
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="GlassNeutralSoftBrush" Color="#0F161A2B"/>
    <SolidColorBrush x:Key="GlassOkBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="GlassOkSoftBrush" Color="#2116A34A"/>
    <SolidColorBrush x:Key="GlassWarnBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="GlassWarnSoftBrush" Color="#24F59E0B"/>
    <SolidColorBrush x:Key="GlassBadBrush" Color="#C81E1E"/>
    <SolidColorBrush x:Key="GlassBadSoftBrush" Color="#1FEF4444"/>

    <DropShadowEffect x:Key="GlassCardShadow" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.07" Color="#1E2450"/>
    <DropShadowEffect x:Key="GlassPopupShadow" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.16" Color="#1E2450"/>
    <DropShadowEffect x:Key="GlassSoftShadow" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#1E2450"/>

    <!-- ===== Tekst ===== -->
    <Style x:Key="GlassH1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
    </Style>
    <Style x:Key="GlassLead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="GlassH3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GlassCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="GlassTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
    </Style>
    <Style x:Key="GlassH2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GlassSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="GlassLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="GlassOptionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
    </Style>
    <Style x:Key="GlassMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassMonoFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Ikona liniowa 24×24; umieszczać w Grid 24×24 wewnątrz Viewbox. -->
    <Style x:Key="GlassIconPath" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="StrokeThickness" Value="2.1"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stretch" Value="None"/>
    </Style>

    <!-- ===== Powierzchnie ===== -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Effect" Value="{StaticResource GlassCardShadow}"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GlassInset" TargetType="Border">
        <Setter Property="Background" Value="#99FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style x:Key="GlassNote" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassAccentSoftBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource GlassAccentInkBrush}"/>
    </Style>
    <Style x:Key="GlassWarnNote" TargetType="Border" BasedOn="{StaticResource GlassNote}">
        <Setter Property="Background" Value="{StaticResource GlassWarnSoftBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource GlassWarnBrush}"/>
    </Style>
    <Style x:Key="GlassIconTile" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
        <Setter Property="TextElement.Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GlassPill" TargetType="Border">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Background" Value="{StaticResource GlassNeutralSoftBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.FontSize" Value="11"/>
        <Setter Property="TextElement.FontWeight" Value="Bold"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource GlassInk2Brush}"/>
    </Style>
    <Style x:Key="GlassDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource GlassLineBrush}"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>

    <!-- ===== Przyciski ===== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassSurface2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassDangerButton" TargetType="Button" BasedOn="{StaticResource GlassPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource GlassBadBrush}"/>
    </Style>
    <Style x:Key="GlassTextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassAccentInkBrush}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
    </Style>
    <Style x:Key="GlassChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Okrągły przycisk z podpowiedzią. -->
    <Style x:Key="InfoButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Help"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
        <Setter Property="ToolTipService.ShowDuration" Value="120000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource GlassNeutralSoftBrush}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GlassAccentInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Podpowiedzi ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource GlassFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="8,4,8,12"
                            Background="#F7FFFFFF"
                            BorderBrush="{StaticResource GlassLineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="11,9"
                            Effect="{StaticResource GlassPopupShadow}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="InfoToolTipStyle" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="Placement" Value="Mouse"/>
        <Setter Property="HorizontalOffset" Value="10"/>
        <Setter Property="VerticalOffset" Value="10"/>
    </Style>

    <!-- ===== Pola tekstowe ===== -->
    <!-- Pole hasła (token bota) — ten sam wygląd co zwykłe pole tekstowe. -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource GlassFieldBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E6FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource GlassFieldBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E6FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Pole binda wyglądające jak klawisz. -->
    <Style x:Key="GlassKeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource GlassMonoFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="ToolTip" Value="Kliknij i naciśnij klawisz"/>
    </Style>
    <!-- Pole binda jak w canvie: jedno zaokrąglone pole z klawiszem po lewej i akcjami po prawej. -->
    <Style x:Key="GlassBindField" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="5,4,4,4"/>
        <!-- Pole bindu ma szerokość zawartości: klawisz, Zapisz i kosz, bez pustego miejsca. -->
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <!-- Klawisz binda w postaci nakładki klawiatury; kliknięcie rozpoczyna przechwytywanie (obsługa w kodzie). -->
    <Style x:Key="GlassKeyCap" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#29161A2B"/>
        <Setter Property="BorderThickness" Value="1,1,1,2.5"/>
        <Setter Property="FontFamily" Value="{StaticResource GlassMonoFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTip" Value="Kliknij i naciśnij klawisz, potem wybierz Zapisz"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="Brak" FontStyle="Italic" FontWeight="Normal"
                                       Foreground="{StaticResource GlassInk2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="{TemplateBinding Padding}" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F7F8FC"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Mały przycisk z ikoną wewnątrz pola (np. kosz przy bindzie). -->
    <Style x:Key="GlassMiniIconButton" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassBadSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource GlassBadBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassBindSaveButton" TargetType="Button" BasedOn="{StaticResource GlassTextButton}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <Style x:Key="GlassMonoBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource GlassMonoFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- ===== Lista rozwijana ===== -->
    <Style x:Key="GlassComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassNeutralSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GlassAccentInkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource GlassComboItem}"/>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="Background" Value="{StaticResource GlassFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,0,28,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource GlassComboItem}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1"
                                            CornerRadius="11">
                                        <Path HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,11,0"
                                              Data="M0,0 L5,5 L10,0"
                                              Stroke="{StaticResource GlassInk2Brush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E6FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Margin="10,0,10,16"
                                    Background="#FAFFFFFF"
                                    BorderBrush="{StaticResource GlassLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="4"
                                    Effect="{StaticResource GlassPopupShadow}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Przełącznik (CheckBox): opis po lewej, suwak po prawej ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Text"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Border x:Name="Track"
                                Grid.Column="1"
                                Width="40"
                                Height="24"
                                CornerRadius="12"
                                VerticalAlignment="Center"
                                Background="#29161A2B"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                            <Border x:Name="Knob"
                                    Width="18"
                                    Height="18"
                                    Margin="3,0,0,0"
                                    CornerRadius="9"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Effect="{StaticResource GlassSoftShadow}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Text" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kafelek wyboru (RadioButton/ToggleButton) w stylu „chip”. -->
    <Style x:Key="GlassChoiceChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="6,0,10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="#A8FFFFFF"
                            BorderBrush="{StaticResource GlassLineBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassChoiceRadio" TargetType="RadioButton" BasedOn="{StaticResource GlassChoiceChip}"/>

    <!-- ===== Zakładki: segmentowany pasek ===== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Margin="{TemplateBinding Padding}"
                                Background="{StaticResource GlassNeutralSoftBrush}"
                                CornerRadius="14"
                                Padding="4">
                            <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Kolor ustawiany jest tylko na nagłówku; treść zakładki dziedziczy zwykły kolor tekstu. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Height="32" Margin="1.5,0" CornerRadius="10" Background="Transparent">
                        <ContentPresenter x:Name="Hd" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"
                                          TextElement.Foreground="{StaticResource GlassInk2Brush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#99FFFFFF"/>
                            <Setter TargetName="Hd" Property="TextElement.Foreground" Value="{StaticResource GlassInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlassSoftShadow}"/>
                            <Setter TargetName="Hd" Property="TextElement.Foreground" Value="{DynamicResource GlassAccentInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Pasek przewijania ===== -->
    <Style x:Key="GlassScrollRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Margin="2" CornerRadius="3" Background="#2E161A2B"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#52161A2B"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#70161A2B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource GlassScrollRepeat}" Command="ScrollBar.PageUpCommand"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource GlassScrollThumb}" MinHeight="36"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource GlassScrollRepeat}" Command="ScrollBar.PageDownCommand"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource GlassScrollRepeat}" Command="ScrollBar.PageLeftCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GlassScrollThumb}" MinWidth="36"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource GlassScrollRepeat}" Command="ScrollBar.PageRightCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CanContentScroll" Value="False"/>
        <Setter Property="PanningMode" Value="VerticalFirst"/>
    </Style>

    <!-- ===== Nawigacja boczna (RadioButton) ===== -->
    <Style x:Key="GlassNavIconPath" TargetType="Path" BasedOn="{StaticResource GlassIconPath}">
        <Setter Property="StrokeThickness" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource GlassAccentInkBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GlassNavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="GroupName" Value="GlassNav"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Height="40" CornerRadius="13" Padding="12,0" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#8CFFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D9FFFFFF"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlassSoftShadow}"/>
                            <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Przełącznik segmentowy (RadioButton w Border GlassSegmentHost) ===== -->
    <Style x:Key="GlassSegmentHost" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassNeutralSoftBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="GlassSegment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" MinHeight="30" CornerRadius="9" Padding="12,0" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#99FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlassSoftShadow}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GlassAccentInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Chip wyboru (CheckBox) z ptaszkiem ===== -->
    <Style x:Key="GlassChip" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" MinHeight="34" CornerRadius="11" Padding="7,0,12,0"
                            Background="#A8FFFFFF" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Tick" Width="18" Height="18" CornerRadius="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                    Background="{StaticResource GlassNeutralSoftBrush}">
                                <Path x:Name="TickMark" Data="M4,9.5 L7.5,13 L14,5.5" Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
                            <Setter TargetName="Tick" Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
                            <Setter TargetName="TickMark" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slot EQ (CheckBox z numerem) — kolory ustawia kod przez Background/BorderBrush/Foreground ===== -->
    <Style x:Key="GlassSlotCheck" TargetType="CheckBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Background" Value="#99FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInk2Brush}"/>
        <Setter Property="FontFamily" Value="{StaticResource GlassMonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Karta wyboru (RadioButton) z kropką ===== -->
    <Style x:Key="GlassChoiceCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="16" Padding="14,12" Background="#80FFFFFF"
                            BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top">
                                <Ellipse x:Name="Ring" Stroke="#4D161A2B" StrokeThickness="2" Fill="White"/>
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource GlassAccentBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CCFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassAccentSolidBrush}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource GlassAccentSolidBrush}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Okrągły numer kroku. -->
    <Style x:Key="GlassStepNo" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource GlassAccentBrush}"/>
        <Setter Property="TextElement.Foreground" Value="White"/>
        <Setter Property="TextElement.FontWeight" Value="Bold"/>
        <Setter Property="TextElement.FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="GlassNumBadge" TargetType="Border">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource GlassAccentSoftBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource GlassAccentInkBrush}"/>
        <Setter Property="TextElement.FontWeight" Value="Bold"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- Suwak (Slider) w stylu akcentu. -->
    <Style TargetType="Slider">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource GlassNeutralSoftBrush}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" Background="{DynamicResource GlassAccentBrush}" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource GlassScrollRepeat}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="White" Stroke="{DynamicResource GlassAccentSolidBrush}" StrokeThickness="2" Effect="{StaticResource GlassSoftShadow}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pasek postępu. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="4" Background="{StaticResource GlassNeutralSoftBrush}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left" Background="{DynamicResource GlassAccentBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu ikony w zasobniku (Auto Clicker i Kopacz): karta glass zamiast systemowego menu Windows Forms. -->
    <Style x:Key="GlassTrayMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource GlassFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="12" Padding="5" MinWidth="220" CornerRadius="14" Background="#F2FFFFFF" BorderBrush="#FFFFFFFF" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#1E2450"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassTrayMenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource GlassInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Padding="10,8" CornerRadius="9" Background="Transparent" TextElement.Foreground="{TemplateBinding Foreground}">
                        <DockPanel>
                            <!-- Zaznaczona pozycja (np. bieżące konto) dostaje ✓ po prawej — nazwy zostają w jednej linii. -->
                            <Path x:Name="Check" DockPanel.Dock="Right" Width="13" Height="13" Margin="12,0,0,0" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M5,12.5 L9.5,17 L19,7.5" Stroke="{DynamicResource GlassAccentInkBrush}" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            <ContentPresenter x:Name="IconHost" ContentSource="Icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccentSoftBrush}"/>
                            <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource GlassAccentInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassTrayMenuSeparator" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{StaticResource GlassLineBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Każde menu kontekstowe w programie — „Przełącz konto”, „⋯” na kartach kont, prawy przycisk
         w polach tekstowych — w stylu glass, bez szarego menu Windows. -->
    <Style TargetType="ContextMenu" BasedOn="{StaticResource GlassTrayMenu}">
        <Style.Resources>
            <Style TargetType="MenuItem" BasedOn="{StaticResource GlassTrayMenuItem}"/>
            <Style TargetType="Separator" BasedOn="{StaticResource GlassTrayMenuSeparator}"/>
        </Style.Resources>
    </Style>

</ResourceDictionary>
