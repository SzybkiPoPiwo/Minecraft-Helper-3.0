<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Akcent Ocean dla motywu glass (GlassTheme.xaml). -->
    <Color x:Key="GlassAccentColor">#0369A1</Color>
    <Color x:Key="GlassAccent2Color">#4F46E5</Color>
    <Color x:Key="GlassBlob1Color">#6638BDF8</Color>
    <Color x:Key="GlassBlob2Color">#476366F1</Color>
    <Color x:Key="GlassBlob3Color">#472DD4BF</Color>
    <SolidColorBrush x:Key="GlassAccentSolidBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="GlassAccentInkBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="GlassAccentSoftBrush" Color="#1C0369A1"/>
    <LinearGradientBrush x:Key="GlassAccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0369A1"/>
        <GradientStop Offset="1" Color="#4F46E5"/>
    </LinearGradientBrush>
    <DrawingBrush x:Key="GlassBackdropBrush" Stretch="Fill" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#EEF1F8">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.8" RadiusY="0.45">
                            <GradientStop Offset="0" Color="#6638BDF8"/>
                            <GradientStop Offset="1" Color="#0038BDF8"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="1,0.35" GradientOrigin="1,0.35" RadiusX="0.72" RadiusY="0.4">
                            <GradientStop Offset="0" Color="#476366F1"/>
                            <GradientStop Offset="1" Color="#006366F1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.4,1.05" GradientOrigin="0.4,1.05" RadiusX="0.88" RadiusY="0.48">
                            <GradientStop Offset="0" Color="#472DD4BF"/>
                            <GradientStop Offset="1" Color="#002DD4BF"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
