                                                        <Button Name="BtnGoldDepositStopTest" Content="STOP testu" Style="{DynamicResource GlassDangerButton}" Margin="0,0,0,6" IsEnabled="False" Click="BtnGoldDepositStopTest_Click"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="Test wpłaty robi prawdziwą wpłatę wybranych rodzajów złota. Po kliknięciu masz 3 s — z włączonym „Kopanie w tle” gra może zostać pod spodem, bez tego przejdź do gry. Kopacz pozostaje wyłączony; STOP (lub bind Kopacza z grą na wierzchu) przerywa test." FontSize="12" Foreground="#B45309" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <Border Background="#99FFFFFF" BorderBrush="#17161A2B" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,10,0,0">
                                                        <TextBlock Name="TxtGoldDepositStatus" Text="Wyłączone. Ustaw komendę i sprawdź menu przed pierwszą wpłatą." TextWrapping="Wrap" FontSize="12" Foreground="#4F566B"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========== OCHRONA ========== -->
                    <TabItem Name="TabProtection" Header="Ochrona">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,2,8,12">
                                <StackPanel Margin="4,4,4,18">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ochrona" Style="{StaticResource GlassH1}"/>
                                    </StackPanel>
                                    <TextBlock Text="Co zrobić, gdy ktoś zaatakuje Twoją postać podczas kopania." Style="{StaticResource GlassLead}"/>
                                </StackPanel>

                                <Border Name="BorderEmergencyDamageSoundSection" Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource GlassIconTile}" Width="40" Height="40" CornerRadius="13">
                                                <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoShield}"/></Grid></Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Awaryjna ochrona Kopacza" Style="{StaticResource CardTitle}"/>
                                                    <Border Style="{StaticResource GlassPill}" Background="{DynamicResource GlassAccentSoftBrush}" Margin="10,0,0,0">
                                                        <TextBlock Text="Funkcja testowa" Foreground="{DynamicResource GlassAccentInkBrush}" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoToolTipStyle}" MaxWidth="620"
                                                                     Content="Włącza nasłuch obrażeń i awaryjne wyjście z serwera. Realny nasłuch oraz wpis w HUD uruchamiają się dopiero podczas pracy Kopacza 5/3/3 albo 6/3/3; samo zaznaczenie tej opcji nie pokazuje stale alarmu.&#10;&#10;„Tylko Disconnect”: po alarmie program zatrzymuje Kopacza i wykonuje tylko ESC → Disconnect. Nie wraca na serwer, nie wysyła home ani nie wznawia kopania.&#10;&#10;„Disconnect + powrót”: program po odczekaniu wraca przez Direct Connect. Po wykryciu kilofa wykonuje podstawowy home, czeka czas teleportacji z buforem, wybiera slot 1 i wznawia wcześniejszego Kopacza. Przy potwierdzonym braku kilofa używa awaryjnego home i kończy pracę tego konta. Tryb testowy zawsze oznacza tylko alarm i log."/>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="Słucha dźwięków obrażeń podczas kopania. Po trafieniu zatrzymuje Kopacza i wychodzi z serwera." Style="{StaticResource CardSub}"/>
                                            </StackPanel>
                                            <CheckBox Name="ChkEmergencyDamageSoundEnabled" Grid.Column="2" ToolTip="Włącz awaryjną ochronę" AutomationProperties.Name="Włącz awaryjną ochronę" Checked="ChkEmergencyDamageSoundEnabled_Changed" Unchecked="ChkEmergencyDamageSoundEnabled_Changed"/>
                                        </Grid>
                                        <WrapPanel Margin="0,16,0,0">
                                            <Border Style="{StaticResource ReqItem}"><TextBlock Text="1 · Wykrycie trafienia" FontSize="12" FontWeight="SemiBold"/></Border>
                                            <Viewbox Width="14" Height="14" Margin="0,0,8,8" VerticalAlignment="Center"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Stroke="{StaticResource GlassInk2Brush}" Data="{StaticResource IcoArrowRight}"/></Grid></Viewbox>
                                            <Border Style="{StaticResource ReqItem}"><TextBlock Text="2 · Disconnect" FontSize="12" FontWeight="SemiBold"/></Border>
                                            <Viewbox Width="14" Height="14" Margin="0,0,8,8" VerticalAlignment="Center"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Stroke="{StaticResource GlassInk2Brush}" Data="{StaticResource IcoArrowRight}"/></Grid></Viewbox>
                                            <Border Name="BorderProtectionFlowEnd" Style="{StaticResource ReqItem}"><TextBlock Name="TxtProtectionFlowEnd" Text="Koniec" FontSize="12" FontWeight="SemiBold"/></Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Name="PanelEmergencyDamageSoundContent" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Wykrywanie -->
                                        <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18" VerticalAlignment="Top">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GlassStepNo}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="Wykrywanie obrażeń" Style="{StaticResource CardTitle}" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="Porównuje dźwięk gry ze wzorcami hit1–hit4 z paczki TXT. Działa tylko, gdy Kopacz pracuje." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <DockPanel Margin="0,0,0,14">
                                                    <Button Name="BtnEmergencyDamageSoundRefreshDevices" DockPanel.Dock="Right" Content="Sprawdź" VerticalAlignment="Center" Margin="10,0,0,0" Click="BtnEmergencyDamageSoundRefreshDevices_Click"/>
                                                    <StackPanel>
                                                        <TextBlock Text="Źródło audio" Style="{StaticResource GlassH3}" HorizontalAlignment="Left"/>
                                                        <TextBlock Name="TxtEmergencyDamageSoundSource" Text="Automatycznie z zapisanego procesu Minecrafta" FontSize="12.5" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="Urządzenie zapasowe" Style="{StaticResource GlassLabel}"/>
                                                <ComboBox Name="CbEmergencyDamageSoundDevice" SelectionChanged="CbEmergencyDamageSoundDevice_SelectionChanged"/>
                                                <TextBlock Text="Używane tylko, gdy Windows nie udostępnia jeszcze sesji audio gry. Zwykle nie trzeba go zmieniać." Style="{StaticResource CardSub}" FontSize="11.5" Margin="0,5,0,14"/>
                                                <DockPanel>
                                                    <TextBlock Name="TxtEmergencyDamageSoundSimilarityValue" DockPanel.Dock="Right" Text="90%" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource GlassAccentInkBrush}"/>
                                                    <TextBlock Text="Próg podobieństwa" Style="{StaticResource GlassH3}" HorizontalAlignment="Left"/>
                                                </DockPanel>
                                                <Slider Name="SlEmergencyDamageSoundSimilarity" Minimum="70" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True" Value="90" Margin="0,6,0,0" ValueChanged="SlEmergencyDamageSoundSimilarity_ValueChanged"/>
                                                <TextBlock Text="Wyżej = mniej fałszywych alarmów, ale łatwiej przegapić trafienie." Style="{StaticResource CardSub}" FontSize="11.5" Margin="0,4,0,14"/>
                                                <CheckBox Name="ChkEmergencyDamageSoundTestMode" IsChecked="True" Margin="0,0,0,14" Checked="ChkEmergencyDamageSoundSetting_Changed" Unchecked="ChkEmergencyDamageSoundSetting_Changed">
                                                    <StackPanel>
                                                        <TextBlock Text="Tryb testowy" Style="{StaticResource GlassH3}" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="Tylko alarm i wpis w logu — bez zatrzymywania i wychodzenia z serwera." Style="{StaticResource CardSub}" FontWeight="Normal"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <WrapPanel>
                                                    <Button Name="BtnEmergencyDamageSoundTest" Style="{StaticResource GlassPrimaryButton}" Margin="0,0,8,6" Click="BtnEmergencyDamageSoundTest_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="15" Height="15" Margin="0,0,7,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoEar}"/></Grid></Viewbox>
                                                            <TextBlock Text="Testuj nasłuch (15 s)"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Name="BtnEmergencyDamageSoundStop" Content="Zatrzymaj test" Margin="0,0,8,6" Click="BtnEmergencyDamageSoundStop_Click"/>
                                                    <Button Name="BtnEmergencyDamageSoundReloadReferences" Content="Przeładuj wzorce" Style="{StaticResource GlassTextButton}" Margin="0,0,0,6" Click="BtnEmergencyDamageSoundReloadReferences_Click"/>
                                                </WrapPanel>
                                                <TextBlock Name="TxtEmergencyDamageSoundReferenceInfo" Text="Ładowanie stałych wzorców hit1–hit4..." Style="{StaticResource CardSub}" FontSize="11.5" Margin="0,4,0,8"/>
                                                <Border Style="{StaticResource GlassInset}">
                                                    <TextBlock Name="TxtEmergencyDamageSoundStatus" Text="Nieaktywny." Style="{StaticResource GlassSub}"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. Po alarmie -->
                                        <Border Name="BorderEmergencyReconnectSection" Grid.Column="2" Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18" VerticalAlignment="Top">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GlassStepNo}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Po alarmie" Style="{StaticResource CardTitle}"/>
                                                            <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                                <Button.ToolTip>
                                                                    <ToolTip Style="{StaticResource InfoToolTipStyle}" MaxWidth="620"
                                                                             Content="DISCONNECT + POWRÓT: po awaryjnym Disconnect program czeka ustawiony czas i wraca przez Direct Connect. Po wejściu sprawdza EQ. Gdy znajdzie diamentowy kilof, używa podstawowego home z profilu i wznawia ten sam tryb Kopacza. Gdy kilofa nie ma, używa home „brak kilofa”, czeka na teleport i kończy pracę tego konta. Ponowny dźwięk przed kontrolą kilofa ponownie uruchamia awaryjne wyjście.&#10;&#10;TYLKO DISCONNECT: tylko ESC → Disconnect i zatrzymanie Kopacza, bez ponownego wejścia, home ani wznowienia. Okresowa kontrola połączenia pozostaje wtedy nieaktywna. Zmiana podczas procedury anuluje pozostałe kroki reconnectu; już wysłanych kliknięć lub komend nie można cofnąć."/>
                                                                </Button.ToolTip>
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBlock Text="Wybierz, co ma się stać po trafieniu." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <RadioButton Name="RbProtectionDisconnectOnly" GroupName="ProtectionAfter" Style="{StaticResource GlassChoiceCard}" Checked="ProtectionAfterMode_Checked">
                                                    <StackPanel>
                                                        <TextBlock Text="Tylko Disconnect" Style="{StaticResource GlassH3}" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="Kopacz staje, gra wychodzi z serwera. Na tym koniec — wracasz sam." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton Name="RbProtectionReturn" GroupName="ProtectionAfter" Style="{StaticResource GlassChoiceCard}" Checked="ProtectionAfterMode_Checked">
                                                    <StackPanel>
                                                        <TextBlock Text="Disconnect + powrót i kopanie" Style="{StaticResource GlassH3}" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="Wychodzi, odczekuje, wraca, sprawdza kilof i wznawia ten sam tryb. Brak kilofa: /home „brak kilofa” i zakończenie pracy tego konta." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </RadioButton>

                                                <StackPanel Name="PanelEmergencyReconnectContent" Margin="0,6,0,0">
                                                    <TextBlock Text="Wróć po" Style="{StaticResource GlassLabel}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                        <TextBox Name="TxtEmergencyReconnectDelaySeconds" Width="96" Text="30" Style="{StaticResource GlassMonoBox}" TextChanged="EmergencyReconnectSetting_Changed"/>
                                                        <TextBlock Text="sekund" Style="{StaticResource GlassSub}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Name="ChkAutoReconnectEnabled" Margin="0,0,0,4" Checked="ChkAutoReconnectEnabled_Changed" Unchecked="ChkAutoReconnectEnabled_Changed">
                                                        <StackPanel>
                                                            <TextBlock Text="Okresowa kontrola połączenia" Style="{StaticResource GlassH3}" HorizontalAlignment="Left"/>
                                                            <TextBlock Text="Gdy Auto EQ trzy razy nie otworzy ekwipunku, robi pełny reconnect. Brak kilofa → /home „brak kilofa”." Style="{StaticResource CardSub}" FontWeight="Normal"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <TextBlock Name="TxtAutoReconnectAvailability" Style="{StaticResource CardSub}" FontSize="11.5" Margin="0,2,0,12"/>
                                                    <Border Style="{StaticResource GlassInset}" Margin="0,0,0,10">
                                                        <TextBlock Name="TxtEmergencyReconnectProfileSummary" Text="Profil: oczekiwanie na dane Auto reconnect..." Style="{StaticResource GlassSub}"/>
                                                    </Border>
                                                </StackPanel>
                                                <DockPanel>
                                                    <Button Name="BtnEmergencyReconnectStop" DockPanel.Dock="Right" Content="Zatrzymaj procedurę" Style="{StaticResource GlassDangerButton}" Margin="10,0,0,0" VerticalAlignment="Top" Click="BtnEmergencyReconnectStop_Click"/>
                                                    <Border Style="{StaticResource GlassInset}">
                                                        <TextBlock Name="TxtEmergencyReconnectStatus" Text="Gotowe. Reconnect uruchomi się po realnym alarmie, jeśli wybrano powrót." Style="{StaticResource GlassSub}"/>
                                                    </Border>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 3. Profil powrotu -->
                                    <Border Name="BorderAutoReconnectSection" Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource GlassStepNo}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Profil powrotu" Style="{StaticResource CardTitle}"/>
                                                        <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoToolTipStyle}" MaxWidth="560"
                                                                         Content="Profil służy do powrotu, gdy wybrano „Disconnect + powrót”. W trybie tylko Disconnect profil i home nie są wymagane. Powrót wymaga aktualnej paczki Minecraft Helper, etykiet [MH] i GUI Scale: Large.&#10;&#10;Okresowa kontrola współpracuje z Auto EQ: jeżeli zaplanowane czyszczenie trzykrotnie nie zdoła otworzyć ekwipunku, uruchamiany jest pełny reconnect przez Direct Connect. Jeżeli rozpoznane EQ nie zawiera znacznika diamentowego kilofa, program używa home „brak kilofa” z wybranego profilu i kończy właściwego Kopacza. Nieznany ekran oraz komunikat o banie zatrzymują automat bez dalszego klikania. Testy ręczne wykonuj przy widocznym, aktywnym oknie gry."/>
                                                            </Button.ToolTip>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Text="Serwer, home i czasy używane przy powrocie po alarmie." Style="{StaticResource CardSub}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" VerticalAlignment="Center" Click="BtnAutoReconnectAddProfile_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.6" Data="{StaticResource IcoPlus}"/></Grid></Viewbox>
                                                        <TextBlock Text="Dodaj serwer"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <StackPanel Name="PanelAutoReconnectContent" Margin="0,18,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Profil używany podczas odzyskiwania połączenia" Style="{StaticResource GlassLabel}" Margin="0,0,0,8"/>
                                                        <WrapPanel Name="PanelAutoReconnectServerProfiles" Margin="0,0,0,6"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Edytuj" Style="{StaticResource GlassTextButton}" Click="BtnAutoReconnectEditProfile_Click"/>
                                                            <Button Content="Usuń" Style="{StaticResource GlassTextButton}" Foreground="{StaticResource GlassBadBrush}" Click="BtnAutoReconnectDeleteProfile_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource GlassInset}" Padding="16,14">
                                                        <StackPanel>
                                                            <TextBlock Name="TxtAutoReconnectSelectedProfileName" Text="Brak profilu" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Adres" Style="{StaticResource GlassSub}"/>
                                                                <TextBlock Name="TxtAutoReconnectSelectedProfileAddress" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Powrót do home" Style="{StaticResource GlassSub}"/>
                                                                <TextBlock Name="TxtAutoReconnectSelectedProfileHome" Grid.Column="1" FontWeight="SemiBold" FontFamily="{StaticResource GlassMonoFont}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="Czasy" Style="{StaticResource GlassSub}"/>
                                                                <TextBlock Name="TxtAutoReconnectSelectedProfileTiming" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Pola zgodności ze starszym settings.json. Edycja odbywa się w oknie profilu. -->
                                                <StackPanel Visibility="Collapsed">
                                                    <ComboBox Name="CbAutoReconnectProfile" SelectionChanged="AutoReconnectSetting_Changed">
                                                        <ComboBoxItem Content="GUI" Tag="Arivi"/>
                                                        <ComboBoxItem Content="Bez GUI" Tag="Standard"/>
                                                    </ComboBox>
                                                    <TextBox Name="TxtAutoReconnectServerAddress"/>
                                                    <TextBox Name="TxtAutoReconnectHomeCommand"/>
                                                    <TextBox Name="TxtAutoReconnectHomeSlot"/>
                                                    <TextBox Name="TxtAutoReconnectJoinDelay"/>
                                                    <TextBox Name="TxtAutoReconnectTeleportDelay"/>
                                                    <TextBox Name="TxtAutoReconnectWatchdogSeconds"/>
                                                    <TextBox Name="TxtAutoReconnectMaxAttempts"/>
                                                    <UniformGrid Name="PanelAutoReconnectHomeSlots" Rows="3" Columns="9"/>
                                                </StackPanel>

                                                <Border Style="{StaticResource GlassDivider}" Margin="0,18,0,14"/>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Wynik testów reconnectu" Style="{StaticResource GlassH3}" HorizontalAlignment="Left"/>
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
                                                    <Run Text="Przyciski testów są w oknie"/> <Run Text="Menu developera" FontWeight="SemiBold"/><Run Text=". Tu widać wynik testów wejścia, home i kontroli EQ."/>
                                                </TextBlock>
                                                <Border Style="{StaticResource GlassInset}">
                                                    <TextBlock Name="TxtAutoReconnectStatus" Text="Gotowe do testu." Style="{StaticResource GlassSub}" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Testy ochrony są w oknie Menu developera -->
                                    <Border Style="{StaticResource GlassNote}" Margin="0,18,0,0" Padding="16,12">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Otwórz menu developera" Style="{StaticResource GlassPrimaryButton}" VerticalAlignment="Center" Margin="12,0,0,0" Click="BtnOpenDeveloperMenu_Click"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" Text="Testy każdego etapu ochrony (wyjście z serwera, wejście, home, kilof, dźwięk, pełny alarm i pełny cykl z kopaniem) są w osobnym oknie Menu developera — razem z pozostałymi testami i wynikami na żywo."/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========== OKNO GRY (okno, kalibracja, kopanie w tle, sterowanie) ========== -->
                    <TabItem Name="TabBackground" Header="Okno gry">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,2,8,12">
                                <StackPanel Margin="4,4,4,18">
                                    <TextBlock Text="Okno gry" Style="{StaticResource GlassH1}"/>
                                    <TextBlock Text="Które okno Minecrafta należy do tego konta, gdzie stoi na ekranie i czy Kopacz może pracować bez fokusu." Style="{StaticResource GlassLead}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Okno Minecrafta + kalibracja -->
                                    <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource GlassIconTile}" Width="38" Height="38" CornerRadius="12"><Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoWindows}"/></Grid></Viewbox></Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Okno Minecrafta" Style="{StaticResource CardTitle}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="Jedno okno — jedno konto. Okna zajęte przez inne konta są zablokowane." Style="{StaticResource CardSub}"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Proces gry (nie launcher)" Style="{StaticResource GlassLabel}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ComboBox Name="CbTargetProcessList" SelectionChanged="CbTargetProcessList_SelectionChanged"/>
                                                <Button Name="BtnRefreshTargetProcessList" Grid.Column="1" Style="{StaticResource GlassIconButton}" Margin="8,0,0,0" ToolTip="Odśwież listę okien" Click="BtnRefreshTargetProcessList_Click">
                                                    <Viewbox Width="16" Height="16"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.2" Data="{StaticResource IcoRefresh}"/></Grid></Viewbox>
                                                </Button>
                                            </Grid>
                                            <TextBox Name="TxtTargetWindowTitle" Visibility="Collapsed"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Name="BtnSaveTargetWindowTitle" Content="Zapisz okno" Click="BtnSaveTargetWindowTitle_Click"/>
                                                <Button Name="BtnCalibrateWindowTab" Style="{StaticResource GlassPrimaryButton}" Margin="8,0,0,0" ToolTip="Ustawia okno Minecrafta tego konta (854×480) obok okien pozostałych kont." Click="BtnCalibrateWindow_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Stroke="White" Data="M4,8 V4 H8 M16,4 H20 V8 M20,16 V20 H16 M8,20 H4 V16 M9,12 H15 M12,9 V15"/></Grid></Viewbox>
                                                        <TextBlock Text="Kalibruj okno"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Name="TxtWindowCalibrationState" Text="Rozmiar okna: —" Style="{StaticResource CardSub}" Margin="0,10,0,0"/>
                                            <TextBlock Text="Kalibracja działa przy zatrzymanym kopaniu. Gra na pełnym ekranie (F11) jest pomijana. Fokus rozpoznawany po PID — inne klienty javaw nie są mylone." Style="{StaticResource CardSub}" FontSize="11.5" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Kopanie w tle -->
                                    <Border Grid.Column="2" Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource GlassIconTile}" Width="38" Height="38" CornerRadius="12"><Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoWindows}"/></Grid></Viewbox></Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Kopanie w tle" Style="{StaticResource CardTitle}"/>
                                                        <Border Style="{StaticResource GlassPill}" Background="{StaticResource GlassWarnSoftBrush}" Height="20" Margin="8,0,0,0">
                                                            <TextBlock Text="BETA" FontSize="10" Foreground="{StaticResource GlassWarnBrush}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Gra może być zasłonięta, na innym pulpicie albo zminimalizowana." Style="{StaticResource CardSub}"/>
                                                </StackPanel>
                                                <CheckBox Name="ChkBackgroundMiningEnabled" Grid.Column="2" Checked="ChkBackgroundMiningEnabled_Changed" Unchecked="ChkBackgroundMiningEnabled_Changed">
                                                    <CheckBox.ToolTip>
                                                        <ToolTip Style="{StaticResource InfoToolTipStyle}"
                                                                 Content="Kopacz wysyła klawisze i kliknięcia prosto do okna gry tego konta. Bez tej opcji START z panelu Konta działa tylko z grą na wierzchu.&#10;&#10;Możesz zminimalizować Minecrafta — kopanie idzie wtedy na ślepo, a funkcje czytające obraz czekają na przywrócenie okna. W grze wyłącz pauzę po utracie fokusu (F3+P).&#10;&#10;Bindy działają tylko w oknie gry. Aby zatrzymać kopanie, wróć do Minecrafta i użyj binda albo STOP na pasku konta."/>
                                                    </CheckBox.ToolTip>
                                                </CheckBox>
                                            </Grid>
                                            <!-- Osłona: prawie przezroczysta warstwa nad grą, żeby przypadkiem nie wejść do niej myszą -->
                                            <Border Style="{StaticResource GlassInset}" Padding="12,10" Margin="0,14,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Osłona okna gry" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Lekka warstwa w kolorze akcentu nad grą podczas kopania w tle. Mysz nie trafi przypadkiem do Minecrafta; przycisk na osłonie zatrzymuje kopanie i przenosi do gry." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                    <CheckBox Name="ChkGameShieldEnabled" Grid.Column="1" IsChecked="True" Checked="ChkGameShieldEnabled_Changed" Unchecked="ChkGameShieldEnabled_Changed" ToolTip="Osłona okna gry podczas kopania w tle"/>
                                                </Grid>
                                            </Border>
                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Name="BorderBgStateFocus" Style="{StaticResource GlassInset}" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Gra na wierzchu" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Zwykłe sterowanie, bindy działają." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                    <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Stroke="{StaticResource GlassInk2Brush}" Data="{StaticResource IcoArrowRight}"/></Grid></Viewbox>
                                                </StackPanel>
                                                <Border Name="BorderBgStateBackground" Grid.Column="2" Style="{StaticResource GlassInset}" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Sesja w tle" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="Wejście trafia do okna gry. Bindy wyłączone." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock Name="TxtBackgroundStateText" Text="Kopanie w tle jest wyłączone." Style="{StaticResource CardSub}" Margin="0,10,0,12"/>
                                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassNumBadge}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Margin="10,2,0,0" TextWrapping="Wrap" Text="W grze wyłącz pauzę po utracie fokusu: F3 + P."/></Grid>
                                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassNumBadge}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Margin="10,2,0,0" TextWrapping="Wrap" Text="START na pasku konta albo w panelu Konta, albo bind w grze."/></Grid>
                                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassNumBadge}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Margin="10,2,0,0" TextWrapping="Wrap" Text="Przełącz się na swoje okna. Zatrzymanie: STOP albo powrót do gry i bind."/></Grid>
                                            <Border Style="{StaticResource GlassWarnNote}" Margin="0">
                                                <TextBlock TextWrapping="Wrap" FontSize="12" Text="Zminimalizowana gra kopie na ślepo — Auto EQ, CobbleX, wpłata złota i reconnect po obrazie czekają na przywrócenie okna."/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sterowanie w grze -->
                                    <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource GlassIconTile}" Width="38" Height="38" CornerRadius="12"><Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoKeyboard}"/></Grid></Viewbox></Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Sterowanie w grze" Style="{StaticResource CardTitle}"/>
                                                        <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoToolTipStyle}" MaxWidth="500"
                                                                         Content="Ustaw takie same klawisze jak w sterowaniu Minecrafta. Klawisz otwierania chatu jest używany przez wszystkie automatycznie wpisywane komendy. Klawisz wyrzucania jest używany przez Auto EQ razem z lewym Ctrl, aby wyrzucać całe stosy. Domyślnie: T dla chatu i Q dla wyrzucania."/>
                                                            </Button.ToolTip>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Text="Te same klawisze co w ustawieniach Minecrafta tego konta." Style="{StaticResource CardSub}"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Otwieranie czatu" Style="{StaticResource GlassLabel}"/>
                                            <Border Style="{StaticResource GlassBindField}" Margin="0,0,0,12">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Domyślny T" Style="{StaticResource GlassBindSaveButton}" Tag="ChatOpen" Click="BtnResetMinecraftControlKey_Click"/>
                                                    <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource GlassBindSaveButton}" Name="BtnChatOpenKeySave" Click="BtnChatOpenKeySave_Click"/>
                                                    <TextBox Name="TxtChatOpenKey" Tag="ChatOpen" PreviewMouseLeftButtonDown="BindKeyBox_PreviewMouseLeftButtonDown" Style="{StaticResource GlassKeyCap}"/>
                                                </DockPanel>
                                            </Border>
                                            <TextBlock Text="Wyrzucanie przedmiotu" Style="{StaticResource GlassLabel}"/>
                                            <Border Style="{StaticResource GlassBindField}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Domyślny Q" Style="{StaticResource GlassBindSaveButton}" Tag="DropItem" Click="BtnResetMinecraftControlKey_Click"/>
                                                    <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource GlassBindSaveButton}" Name="BtnDropItemKeySave" Click="BtnDropItemKeySave_Click"/>
                                                    <TextBox Name="TxtDropItemKey" Tag="DropItem" PreviewMouseLeftButtonDown="BindKeyBox_PreviewMouseLeftButtonDown" Style="{StaticResource GlassKeyCap}"/>
                                                </DockPanel>
                                            </Border>
                                            <TextBlock Text="Auto EQ używa klawisza wyrzucania z lewym Ctrl (całe stacki) — Ctrl nie może mieć innego skrótu." Style="{StaticResource CardSub}" FontSize="11.5" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sprawdzenie przed startem -->
                                    <Border Grid.Column="2" Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="Sprawdzenie przed startem" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                                            <DockPanel Margin="0,0,0,8"><TextBlock Name="TxtBgCheckWindow" DockPanel.Dock="Right" Text="—" Style="{StaticResource GlassSub}" FontFamily="{StaticResource GlassMonoFont}"/><TextBlock Name="TxtBgCheckWindowLabel" Text="•  Okno gry przypisane do konta"/></DockPanel>
                                            <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="podejrzyj" Style="{StaticResource GlassTextButton}" MinHeight="22" Padding="4,0" Click="BtnAccountPeek_Click"/><TextBlock Text="•  Obraz okna dostępny" VerticalAlignment="Center"/></DockPanel>
                                            <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="test w Ekwipunku" Style="{StaticResource GlassSub}"/><TextBlock Text="•  Znaczniki paczki TXT (rozpoznawanie EQ)"/></DockPanel>
                                            <DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" Text="sprawdź ręcznie" Style="{StaticResource GlassSub}"/><TextBlock Text="•  F3 + P w grze"/></DockPanel>
                                            <TextBlock Text="Bez fokusu nie działają: bindy z klawiatury, auto łowienie (Narzędzia) i ręczne testy reconnectu. Test wpłaty złota działa w tle." Style="{StaticResource CardSub}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========== NARZĘDZIA ========== -->
                    <TabItem Name="TabTools" Header="Narzędzia">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,2,8,12">
                                <StackPanel Margin="4,4,4,18">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Narzędzia" Style="{StaticResource GlassH1}"/>
                                        <Border Style="{StaticResource GlassPill}" Background="{DynamicResource GlassAccentSoftBrush}" Margin="12,6,0,0" Height="24">
                                            <TextBlock Text="Beta" Foreground="{DynamicResource GlassAccentInkBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Dodatkowe makra. Działają tylko z oknem gry na wierzchu." Style="{StaticResource GlassLead}"/>
                                </StackPanel>

                                <Border Style="{StaticResource GlassNote}" Margin="0,0,0,18">
                                    <DockPanel>
                                        <Viewbox Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,8,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.2" Data="{StaticResource IcoInfo}"/></Grid></Viewbox>
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Text="Funkcja jest jeszcze rozwijana — działa, ale może mieć błędy. Nie działa w trybie kopania w tle."/>
                                    </DockPanel>
                                </Border>

                                <Border Name="BorderTestAutoFishingSection" Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource GlassIconTile}" Width="40" Height="40" CornerRadius="13">
                                                <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoFish}"/></Grid></Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Auto łowienie" Style="{StaticResource CardTitle}"/>
                                                    <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoToolTipStyle}" MaxWidth="560"
                                                                     Content="Spławik musi mieć wyraźnie czerwoną część. Zaznacz mały obszar bezpośrednio wokół niej, ustaw bind uruchamiania oraz opcjonalny bind ponownego zaznaczenia. Po zarzuceniu makro czeka 2 sekundy, zapisuje pozycję spławika i zwija dopiero po potwierdzonym ruchu w dół albo zaniku spławika. Jeśli przez 5 sekund od rzutu go nie zobaczy, automatycznie ponawia rzut. Opcjonalna komenda naprawy zatrzymuje łowienie na czas wpisania, a następnie ponownie zarzuca wędkę."/>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="Pilnuje czerwonej części spławika w zaznaczonym obszarze i zwija wędkę po ruchu w dół albo zaniku spławika." Style="{StaticResource CardSub}"/>
                                            </StackPanel>
                                            <CheckBox Name="ChkTestAutoFishingEnabled" Grid.Column="2" ToolTip="Włącz auto łowienie" AutomationProperties.Name="Włącz auto łowienie" Checked="ChkTestAutoFishingEnabled_Changed" Unchecked="ChkTestAutoFishingEnabled_Changed"/>
                                        </Grid>

                                        <StackPanel Name="PanelTestAutoFishingExpandableContent" Margin="0,18,0,0" Visibility="Collapsed">
                                            <Border Name="BorderTestAutoFishingContent">
                                                <Grid Name="PanelTestAutoFishingContent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="320"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Bind start / stop" Style="{StaticResource GlassLabel}"/>
                                                                <Border Style="{StaticResource GlassBindField}">
                                                                    <DockPanel>
                                                                        <Button DockPanel.Dock="Right" Style="{StaticResource GlassMiniIconButton}" ToolTip="Usuń bind" Name="BtnTestAutoFishingBindClear" Tag="TestAutoFishing" Click="BtnClearBind_Click">
                                                                            <Viewbox Width="15" Height="15"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7"/></Grid></Viewbox>
                                                                        </Button>
                                                                        <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource GlassBindSaveButton}" Name="BtnTestAutoFishingBind" Click="BtnTestAutoFishingBind_Click"/>
                                                                        <TextBox Name="TxtTestAutoFishingBind" Tag="TestAutoFishing" PreviewMouseLeftButtonDown="BindKeyBox_PreviewMouseLeftButtonDown" Style="{StaticResource GlassKeyCap}"/>
                                                                    </DockPanel>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Bind zaznaczania" Style="{StaticResource GlassLabel}"/>
                                                                <Border Style="{StaticResource GlassBindField}">
                                                                    <DockPanel>
                                                                        <Button DockPanel.Dock="Right" Style="{StaticResource GlassMiniIconButton}" ToolTip="Usuń bind" Name="BtnTestAutoFishingCaptureBindClear" Tag="TestAutoFishingCaptureArea" Click="BtnClearBind_Click">
                                                                            <Viewbox Width="15" Height="15"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7"/></Grid></Viewbox>
                                                                        </Button>
                                                                        <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource GlassBindSaveButton}" Name="BtnTestAutoFishingCaptureBind" Click="BtnTestAutoFishingCaptureBind_Click"/>
                                                                        <TextBox Name="TxtTestAutoFishingCaptureBind" Tag="TestAutoFishingCaptureArea" PreviewMouseLeftButtonDown="BindKeyBox_PreviewMouseLeftButtonDown" Style="{StaticResource GlassKeyCap}"/>
                                                                    </DockPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Komenda naprawy" Style="{StaticResource GlassLabel}"/>
                                                                <TextBox Name="TxtTestAutoFishingRepairCommand" Style="{StaticResource GlassMonoBox}" TextChanged="TxtTestAutoFishingRepairConfig_TextChanged"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Co (sekund)" Style="{StaticResource GlassLabel}"/>
                                                                <TextBox Name="TxtTestAutoFishingRepairEverySeconds" Style="{StaticResource GlassMonoBox}" TextChanged="TxtTestAutoFishingRepairConfig_TextChanged"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="0 = wyłączone. Po komendzie wędka zarzuca się ponownie." Style="{StaticResource CardSub}" FontSize="11.5" Margin="0,0,0,12"/>
                                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassNumBadge}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Margin="10,2,0,0" TextWrapping="Wrap" Text="Zarzuć wędkę i ustaw kamerę tak, żeby spławik był dobrze widoczny."/></Grid>
                                                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassNumBadge}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Margin="10,2,0,0" TextWrapping="Wrap" Text="Zaznacz mały prostokąt wokół czerwonej części spławika."/></Grid>
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassNumBadge}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Margin="10,2,0,0" TextWrapping="Wrap" Text="Uruchom bindem. Brak spławika przez 5 s = ponowny rzut."/></Grid>
                                                        <TextBlock Name="TxtTestAutoFishingAreaInfo" Text="Brak obszaru monitoringu spławika. Kliknij &quot;Zaznacz obszar&quot;." Style="{StaticResource CardSub}" Margin="0,12,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <Border CornerRadius="16" Background="#1E2030" Height="170" ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Name="TxtTestAutoFishingPreviewInfo" Text="Brak zaznaczonego obszaru." Foreground="#B3FFFFFF" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Image Name="ImgTestAutoFishingPreview" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                                            <Button Name="BtnTestAutoFishingSelectArea" Content="Zaznacz obszar" Style="{StaticResource GlassPrimaryButton}" Margin="0,0,8,0" Click="BtnTestAutoFishingSelectArea_Click"/>
                                                            <Button Name="BtnTestAutoFishingResetArea" Content="Resetuj" Style="{StaticResource GlassTextButton}" Click="BtnTestAutoFishingResetArea_Click"/>
                                                        </StackPanel>
                                                        <Border Style="{StaticResource GlassInset}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Spławik:" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                                <TextBlock Name="TxtTestAutoFishingState" Text="-" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ========== USTAWIENIA ========== -->
                    <TabItem Name="TabSettings" Header="Ustawienia">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,2,8,12">
                                <StackPanel Margin="4,4,4,18">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ustawienia" Style="{StaticResource GlassH1}"/>
                                        <Button Content="?" Style="{StaticResource InfoButtonStyle}" Margin="10,6,0,0">
                                            <Button.ToolTip>
                                                <ToolTip Style="{StaticResource InfoToolTipStyle}" MaxWidth="520"
                                                         Content="JAK SKONFIGUROWAĆ KOPACZA:&#10;1. Uruchom Minecrafta i wejdź do gry.&#10;2. W zakładce Okno gry kliknij Odśwież przy polu Proces gry.&#10;3. Wybierz proces właściwego okna Minecrafta lub BlazingPacka — nie wybieraj launchera.&#10;4. Kliknij Zapisz okno, a potem Kalibruj okno. Wskaźnik fokusu w pasku bocznym zmieni się na zielony, gdy aktywne jest właściwe okno gry.&#10;&#10;HUD (OVERLAY): wyświetla stan Kopacza, Auto EQ, CobbleX, automatycznego łowienia oraz trwających etapów ochrony awaryjnej i reconnectu.&#10;&#10;IMPORT / EXPORT: Exportuj zapisuje konfigurację Kopacza do pliku JSON. Importuj wczytuje taki plik i ustawia go jako aktywną konfigurację. Program zapisuje bieżące ustawienia automatycznie."/>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Profil i kopia ustawień tego konta oraz wspólny wygląd, HUD i sterowanie zdalne. Okno gry i klawisze są w zakładce Okno gry." Style="{StaticResource GlassLead}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <!-- Profil konta -->
                                        <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GlassIconTile}" Width="38" Height="38" CornerRadius="12"><Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoUser}"/></Grid></Viewbox></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Profil konta" Style="{StaticResource CardTitle}" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="Zmień nazwę albo przełącz się na inne konto. Pozostałe konta dalej pracują w tle." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Button Name="BtnRenameAccount" Content="Zmień nazwę" Click="BtnRenameAccount_Click"/>
                                                    <Button Name="BtnSwitchAccount" Content="Przełącz konto ▾" Margin="8,0,0,0" ToolTip="Wybierz konto, którego ustawienia chcesz edytować" Click="BtnSwitchAccount_Click"/>
                                                </StackPanel>
                                                <TextBlock Text="Nazwa wyświetlana" Style="{StaticResource GlassLabel}"/>
                                                <Border Style="{StaticResource GlassInset}" Padding="12,9" Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding Text, ElementName=TxtAccountName}" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="Uruchom ten profil bezpośrednio" Style="{StaticResource GlassLabel}"/>
                                                <Border Style="{StaticResource GlassInset}" Padding="12,9" Margin="0,0,0,12">
                                                    <TextBlock Name="TxtProfileCommandLine" FontFamily="{StaticResource GlassMonoFont}" FontSize="12" TextWrapping="Wrap"/>
                                                </Border>
                                                <TextBlock Text="Dane profilu" Style="{StaticResource GlassLabel}"/>
                                                <Border Style="{StaticResource GlassInset}" Padding="12,9">
                                                    <TextBlock Name="TxtProfileDataPath" FontFamily="{StaticResource GlassMonoFont}" FontSize="12" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Kopia ustawień -->
                                        <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GlassIconTile}" Width="38" Height="38" CornerRadius="12"><Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoTransfer}"/></Grid></Viewbox></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Kopia ustawień" Style="{StaticResource CardTitle}"/>
                                                            <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                                <Button.ToolTip>
                                                                    <ToolTip Style="{StaticResource InfoToolTipStyle}" MaxWidth="480"
                                                                             Content="Exportuj tworzy plik JSON z konfiguracją Kopacza, Auto EQ, CobbleX, reconnectu i HUD. Importuj wczytuje wskazany plik, sprawdza jego ustawienia i zapisuje je jako aktywne. Bieżąca konfiguracja jest również zapisywana automatycznie."/>
                                                                </Button.ToolTip>
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBlock Text="Plik JSON z konfiguracją tego konta." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Name="BtnExportSettings" Content="Exportuj" Margin="0,0,8,0" Click="BtnExportSettings_Click"/>
                                                    <Button Name="BtnImportSettings" Content="Importuj" Style="{StaticResource GlassPrimaryButton}" Click="BtnImportSettings_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Wygląd -->
                                        <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GlassIconTile}" Width="38" Height="38" CornerRadius="12"><Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoPalette}"/></Grid></Viewbox></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Wygląd" Style="{StaticResource CardTitle}" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="Jasne szkło i kolor akcentu." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="Akcent" Style="{StaticResource GlassLabel}" Margin="0,0,0,8"/>
                                                <WrapPanel Margin="0,0,0,14">
                                                    <RadioButton Name="RbAccentIris" GroupName="GlassAccent" Style="{StaticResource GlassChoiceRadio}" Tag="iris" Margin="0,0,8,6" Checked="AccentSwatch_Checked">
                                                        <StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,7,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Offset="0" Color="#5458E8"/><GradientStop Offset="1" Color="#7C3AED"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Iris" VerticalAlignment="Center"/></StackPanel>
                                                    </RadioButton>
                                                    <RadioButton Name="RbAccentKoral" GroupName="GlassAccent" Style="{StaticResource GlassChoiceRadio}" Tag="koral" Margin="0,0,8,6" Checked="AccentSwatch_Checked">
                                                        <StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,7,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Offset="0" Color="#D63A44"/><GradientStop Offset="1" Color="#C2410C"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Koral" VerticalAlignment="Center"/></StackPanel>
                                                    </RadioButton>
                                                    <RadioButton Name="RbAccentOcean" GroupName="GlassAccent" Style="{StaticResource GlassChoiceRadio}" Tag="ocean" Margin="0,0,8,6" Checked="AccentSwatch_Checked">
                                                        <StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,7,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Offset="0" Color="#0369A1"/><GradientStop Offset="1" Color="#4F46E5"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Ocean" VerticalAlignment="Center"/></StackPanel>
                                                    </RadioButton>
                                                </WrapPanel>
                                                <CheckBox Name="ChkAnimatedBackgroundEnabled" Checked="ChkAnimatedBackgroundEnabled_Changed" Unchecked="ChkAnimatedBackgroundEnabled_Changed">
                                                    <StackPanel>
                                                        <TextBlock Text="Animowane tło" Style="{StaticResource GlassH3}" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="Powolny ruch kolorowych plam pod szkłem. Maks. 15 FPS, pauza w tle." Style="{StaticResource CardSub}" FontWeight="Normal"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </StackPanel>
                                        </Border>

                                        <!-- HUD -->
                                        <Border Name="BorderOverlayHudSection" Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GlassIconTile}" Width="38" Height="38" CornerRadius="12"><Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoMonitor}"/></Grid></Viewbox></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="HUD nad grą" Style="{StaticResource CardTitle}"/>
                                                            <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                                <Button.ToolTip>
                                                                    <ToolTip Style="{StaticResource InfoToolTipStyle}" MaxWidth="560"
                                                                             Content="HUD to mały panel informacyjny wyświetlany nad grą. Pokazuje tylko aktywne działania Kopacza: kopanie, Auto EQ, CobbleX, automatyczne łowienie oraz etapy ochrony awaryjnej i reconnectu. Wpis ochrony pojawia się przy pracującym Kopaczu, ręcznym teście albo rozpoczętej procedurze. Po włączeniu wybierz monitor i narożnik ekranu. Opcja Animacje HUD steruje wyłącznie animowanym pojawianiem się panelu."/>
                                                                </Button.ToolTip>
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBlock Text="Panel z aktywnymi działaniami Kopacza nad oknem gry." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                    <CheckBox Name="ChkOverlayHudEnabled" Grid.Column="2" ToolTip="Włącz HUD" AutomationProperties.Name="Włącz HUD" Checked="ChkOverlaySettings_Changed" Unchecked="ChkOverlaySettings_Changed"/>
                                                </Grid>
                                                <StackPanel Name="PanelOverlayHudContent" Margin="0,16,0,0" Visibility="Collapsed">
                                                    <CheckBox Name="ChkOverlayAnimationsEnabled" Margin="0,0,0,12" Checked="ChkOverlaySettings_Changed" Unchecked="ChkOverlaySettings_Changed">
                                                        <TextBlock Text="Animacje HUD" Style="{StaticResource GlassH3}" HorizontalAlignment="Left"/>
                                                    </CheckBox>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Monitor" Style="{StaticResource GlassLabel}"/>
                                                            <ComboBox Name="CbOverlayMonitor" SelectionChanged="CbOverlayMonitor_SelectionChanged"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Pozycja" Style="{StaticResource GlassLabel}"/>
                                                            <ComboBox Name="CbOverlayCorner" SelectionChanged="CbOverlayCorner_SelectionChanged">
                                                                <ComboBoxItem>Prawy dolny</ComboBoxItem>
                                                                <ComboBoxItem>Lewy dolny</ComboBoxItem>
                                                                <ComboBoxItem>Prawy górny</ComboBoxItem>
                                                                <ComboBoxItem>Lewy górny</ComboBoxItem>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <!-- Paczka zasobów: Kopacz tworzy ją sam z plików gry 1.8.8 -->
                                        <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GlassIconTile}" Width="38" Height="38" CornerRadius="12"><Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoBox}"/></Grid></Viewbox></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Paczka zasobów" Style="{StaticResource CardTitle}"/>
                                                            <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                                <Button.ToolTip>
                                                                    <ToolTip Style="{StaticResource InfoToolTipStyle}" MaxWidth="540"
                                                                             Content="Auto EQ, CobbleX, kontrola kilofa, wpłata złota, ochrona i reconnect rozpoznają przedmioty i ekrany po znacznikach z paczki Minecraft Helper. Kopacz tworzy ją sam z plików Twojej gry (versions\1.8.8\1.8.8.jar) i zapisuje w folderze resourcepacks — nie trzeba niczego pobierać.&#10;&#10;Paczka zawiera domyślny wygląd 1.8.8 ze znacznikami, bo detektory rozpoznają domyślny cobblestone (różowy), cyfry stacków i ramki ekwipunku. Ustaw ją w grze NAD innymi paczkami.&#10;&#10;Przy starcie Kopacz sam tworzy brakującą albo nieaktualną paczkę. Po aktualizacji paczki w grze wystarczy F3 + T albo ponowne wejście w Paczki zasobów."/>
                                                                </Button.ToolTip>
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBlock Text="Znaczniki dla Auto EQ i ochrony — tworzone z Twojej gry 1.8.8." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Style="{StaticResource GlassInset}" Padding="12,9" Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Name="EllResourcePackStatus" Width="8" Height="8" Fill="{StaticResource GlassInk2Brush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                        <TextBlock Name="TxtResourcePackStatus" Text="Sprawdzam paczkę zasobów…" TextWrapping="Wrap" FontSize="12.5"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Name="TxtResourcePackPath" Style="{StaticResource CardSub}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                <Border Name="BorderResourcePackWarning" Style="{StaticResource GlassWarnNote}" Margin="0,0,0,10" Visibility="Collapsed">
                                                    <TextBlock Name="TxtResourcePackWarning" TextWrapping="Wrap" FontSize="12"/>
                                                </Border>

                                                <WrapPanel Margin="0,0,0,10">
                                                    <Button Name="BtnResourcePackCreate" Content="Utwórz paczkę ponownie" Style="{StaticResource GlassPrimaryButton}" Margin="0,0,8,6" Click="BtnResourcePackCreate_Click" ToolTip="Buduje paczkę od nowa z plików gry i zastępuje poprzednią wersję w resourcepacks."/>
                                                    <Button Name="BtnResourcePackOpenFolder" Content="Otwórz folder resourcepacks" Margin="0,0,8,6" Click="BtnResourcePackOpenFolder_Click"/>
                                                </WrapPanel>
                                                <Border Style="{StaticResource GlassNote}" Margin="0">
                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Text="W grze: Opcje → Paczki zasobów → przenieś „MinecraftHelper AutoEQ + CobbleX (1.8.8)” na prawą stronę, NAD inne paczki, i ustaw GUI Scale: Large."/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Bot Discord (wspólny dla wszystkich kont) -->
                                        <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GlassIconTile}" Width="38" Height="38" CornerRadius="12"><Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M4,6 H20 V16 H11 L7,20 V16 H4 Z M8,10 H16 M8,13 H13"/></Grid></Viewbox></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Bot Discord" Style="{StaticResource CardTitle}"/>
                                                            <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                                <Button.ToolTip>
                                                                    <ToolTip Style="{StaticResource InfoToolTipStyle}" MaxWidth="520"
                                                                             Content="Własny bot Discord: powiadomienia o alarmach, reconnekcie, braku kilofa i zatrzymaniu kopania (ze zrzutem ekranu i oznaczeniem przy wyjściu z serwera) oraz komendy z telefonu: status, statystyki, dane z dziennika, zrzut, jedzenie, ekwipunek, START (z wyborem 5/3/3 albo 6/3/3) i STOP. „Wyślij test” sprawdza token i kanał, a „Testuj powiadomienia” wysyła przykład każdego włączonego powiadomienia. Ustawienia są wspólne dla wszystkich kont; bot działa w głównym oknie Kopacza. Token jest zaszyfrowany kluczem Twojego konta Windows i nie trafia do settings.json ani logów."/>
                                                                </Button.ToolTip>
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBlock Text="Powiadomienia i komendy z telefonu. Wspólne dla wszystkich kont." Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Name="BtnDiscordGuide" Style="{StaticResource GlassChipButton}" Content="Jak skonfigurować?" Margin="0,0,12,0" Click="BtnDiscordGuide_Click" ToolTip="Instrukcja krok po kroku: od utworzenia bota w Discordzie po pierwszą komendę"/>
                                                        <CheckBox Name="ChkDiscordEnabled" VerticalAlignment="Center" ToolTip="Włącz bota Discord" AutomationProperties.Name="Włącz bota Discord"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Name="BorderDiscordStatus" Style="{StaticResource GlassInset}" Padding="12,9" Margin="0,0,0,14">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Name="EllDiscordStatus" Width="8" Height="8" Fill="{StaticResource GlassInk2Brush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                        <TextBlock Name="TxtDiscordStatus" Text="Bot wyłączony." TextWrapping="Wrap" FontSize="12.5"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="Token bota" Style="{StaticResource GlassLabel}"/>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <PasswordBox Name="PwdDiscordToken" MinHeight="38" Padding="10,0" VerticalContentAlignment="Center" KeyDown="PwdDiscordToken_KeyDown" PasswordChanged="PwdDiscordToken_PasswordChanged" ToolTip="Developer Portal → Twoja aplikacja → Bot → Reset Token. Wklej i naciśnij Enter albo kliknij Zapisz."/>
                                                    <Button Name="BtnDiscordClearToken" Grid.Column="1" Content="Usuń token" Margin="8,0,0,0" Click="BtnDiscordClearToken_Click"/>
                                                </Grid>
                                                <TextBlock Name="TxtDiscordTokenState" Text="Brak zapisanego tokenu." Style="{StaticResource CardSub}" FontSize="11.5" Margin="0,0,0,12"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="ID kanału" Style="{StaticResource GlassLabel}"/>
                                                        <TextBox Name="TxtDiscordChannelId" Style="{StaticResource GlassMonoBox}" ToolTip="PPM na kanał → Kopiuj ID kanału (włącz tryb dewelopera w Discordzie)"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Twoje ID (właściciele, po przecinku)" Style="{StaticResource GlassLabel}"/>
                                                        <TextBox Name="TxtDiscordOwnerIds" Style="{StaticResource GlassMonoBox}" ToolTip="PPM na siebie → Kopiuj ID użytkownika. Tylko te osoby mogą wydawać komendy."/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Prefiks" Style="{StaticResource GlassLabel}"/>
                                                        <TextBox Name="TxtDiscordPrefix" Style="{StaticResource GlassMonoBox}" Text="!" MaxLength="3"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Zrzut co (min, 0 = wył.)" Style="{StaticResource GlassLabel}"/>
                                                        <TextBox Name="TxtDiscordScreenshotMinutes" Style="{StaticResource GlassMonoBox}" Text="0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Status co (min, 0 = wył.)" Style="{StaticResource GlassLabel}"/>
                                                        <TextBox Name="TxtDiscordStatusMinutes" Style="{StaticResource GlassMonoBox}" Text="0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Powiadomienia" Style="{StaticResource GlassLabel}" Margin="0,0,0,6"/>
                                                <WrapPanel Margin="0,0,0,6">
                                                    <CheckBox Name="ChkDiscordNotifyProtection" Style="{DynamicResource GlassChip}" Content="Alarm ochrony" IsChecked="True" Margin="0,0,6,6"/>
                                                    <CheckBox Name="ChkDiscordNotifyReconnect" Style="{DynamicResource GlassChip}" Content="Reconnect" IsChecked="True" Margin="0,0,6,6"/>
                                                    <CheckBox Name="ChkDiscordNotifyPickaxe" Style="{DynamicResource GlassChip}" Content="Brak kilofa" IsChecked="True" Margin="0,0,6,6"/>
                                                    <CheckBox Name="ChkDiscordNotifyStartStop" Style="{DynamicResource GlassChip}" Content="Start / koniec kopania" IsChecked="True" Margin="0,0,6,6"/>
                                                    <CheckBox Name="ChkDiscordNotifyErrors" Style="{DynamicResource GlassChip}" Content="Błędy" IsChecked="True" Margin="0,0,6,6"/>
                                                </WrapPanel>
                                                <WrapPanel Margin="0,0,0,12">
                                                    <CheckBox Name="ChkDiscordAttachScreenshot" Style="{DynamicResource GlassChip}" Content="Dołącz zrzut ekranu" IsChecked="True" Margin="0,0,6,6"/>
                                                    <CheckBox Name="ChkDiscordMention" Style="{DynamicResource GlassChip}" Content="Oznacz mnie przy alarmach" IsChecked="True" Margin="0,0,6,6"/>
                                                </WrapPanel>

                                                <WrapPanel Margin="0,0,0,6">
                                                    <Button Name="BtnDiscordSave" Content="Zapisz ustawienia Discord" Style="{StaticResource GlassPrimaryButton}" Click="BtnDiscordSave_Click" Margin="0,0,8,6"/>
                                                    <Button Name="BtnDiscordTest" Content="Wyślij test" Margin="0,0,8,6" Click="BtnDiscordTest_Click" ToolTip="Jedna wiadomość: sprawdza token, kanał i uprawnienia bota."/>
                                                    <Button Name="BtnDiscordTestNotifications" Content="Testuj powiadomienia" Margin="0,0,8,6" Click="BtnDiscordTestNotifications_Click" ToolTip="Wysyła na kanał przykład każdego włączonego powiadomienia — z oznaczeniem i zrzutem z okna gry tego konta, tak jak przy prawdziwym zdarzeniu. W grze nic się nie dzieje."/>
                                                </WrapPanel>

                                                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                                    <TextBlock Text="Komendy (z prefiksem, np. !status)" Style="{StaticResource GlassLabel}" VerticalAlignment="Center" Margin="0"/>
                                                    <Button Name="BtnDiscordCommands" DockPanel.Dock="Right" Style="{StaticResource GlassChipButton}" Content="Włącz / wyłącz komendy" Click="BtnDiscordCommands_Click" ToolTip="Okno z przełącznikiem przy każdej komendzie bota. Wyłączona komenda nie działa i znika z !pomoc."/>
                                                </DockPanel>
                                                <!-- Pigułki budowane z DiscordCommands; wyłączone komendy są przekreślone. -->
                                                <WrapPanel Name="PanelDiscordCommandPills" Margin="0,0,0,8"/>
                                                <Border Style="{StaticResource GlassNote}" Margin="0">
                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Text="Z Discorda można podglądać, uruchamiać i zatrzymywać kopanie, a także wyjść z serwera (!leave) i wrócić na niego z kopaniem (!join — reconnect, /home, kontrola EQ i start) — nigdy wpisywać komend w grze. Bez gry na wierzchu sterowanie idzie przez kopanie w tle; tryb dopiszesz na końcu, np. !join Konto 2 5/3/3. Komendy przyjmowane są wyłącznie od wpisanych właścicieli, na wybranym kanale albo w wiadomości prywatnej do bota."/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- O programie -->
                                        <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GlassIconTile}" Width="38" Height="38" CornerRadius="12"><Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoInfo}"/></Grid></Viewbox></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="O programie" Style="{StaticResource CardTitle}" HorizontalAlignment="Left"/>
                                                        <TextBlock Name="TxtAboutVersion" Text="Minecraft Helper — Kopacz" Style="{StaticResource CardSub}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Autor" Style="{StaticResource GlassSub}"/>
                                                    <TextBlock Grid.Column="1" Text="SzybkiPoPiwo" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="GitHub" Style="{StaticResource GlassSub}"/>
                                                    <TextBlock Grid.Column="1">
                                                        <Hyperlink NavigateUri="https://github.com/SzybkiPoPiwo" RequestNavigate="Github_RequestNavigate" Foreground="{DynamicResource GlassAccentInkBrush}" FontWeight="SemiBold" TextDecorations="{x:Null}">github.com/SzybkiPoPiwo</Hyperlink>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Discord" Style="{StaticResource GlassSub}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="twojstaryricardo" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" FontWeight="SemiBold" IsReadOnlyCaretVisible="False"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Menu developera: karta z przyciskiem; PanelDeveloperMenu jest przenoszony do osobnego okna (DeveloperMenuWindow) -->
                                <Border Name="BorderDeveloperMenu" Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource GlassIconTile}" Width="40" Height="40" CornerRadius="13"><Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoFlask}"/></Grid></Viewbox></Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Menu developera" Style="{StaticResource CardTitle}"/>
                                                <TextBlock Text="Wszystkie przyciski testowe w osobnym oknie, z wynikami na żywo — można je mieć obok gry." Style="{StaticResource CardSub}"/>
                                            </StackPanel>
                                            <Button Name="BtnDeveloperMenuOpen" Grid.Column="2" Content="Otwórz menu developera" Style="{StaticResource GlassPrimaryButton}" VerticalAlignment="Center" Click="BtnOpenDeveloperMenu_Click" ToolTip="Osobne okno z testami ochrony, reconnectu, Auto EQ, złota, Discorda i paczki zasobów oraz dziennikiem na żywo."/>
                                        </Grid>

                                        <StackPanel Name="PanelDeveloperMenu" Margin="0,18,0,0" Visibility="Collapsed">
                                            <Border Style="{StaticResource GlassWarnNote}" Margin="0,0,0,14">
                                                <TextBlock TextWrapping="Wrap" FontSize="12" Text="Testy wysyłają prawdziwe klawisze i komendy w grze — rób je na bezpiecznym serwerze, z małą ilością przedmiotów. Powiadomienia Discord przyjdą z dopiskiem TEST. Testy klikające od razu ruszają po 5 s odliczania — w tym czasie przejdź do gry (przy Kopaniu w tle nie trzeba)."/>
                                            </Border>

                                            <!-- Wyniki na żywo -->
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="WYNIKI TESTÓW NA ŻYWO" Style="{StaticResource GlassCaption}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Border Style="{StaticResource GlassInset}" Padding="12,10" Margin="0,0,0,18" MinHeight="120">
                                                <TextBlock Name="TxtDeveloperLog" FontFamily="{StaticResource GlassMonoFont}" FontSize="11.5" TextWrapping="Wrap" Text="Brak wpisów."/>
                                            </Border>

                                            <!-- Ochrona i reconnect -->
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Content="STOP wszystkiego" Style="{StaticResource GlassDangerButton}" Click="BtnProtectionTestStop_Click" ToolTip="Zatrzymuje każdy test, nasłuch, awaryjny powrót i reconnect."/>
                                                <TextBlock Text="OCHRONA I RECONNECT" Style="{StaticResource GlassCaption}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="1 · Rozpoznaj ekran" HorizontalAlignment="Stretch" Margin="0,0,12,0" Click="BtnAutoReconnectRecognize_Click"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="Co Kopacz widzi na ekranie: gra, menu główne, lista serwerów, łączenie, rozłączenie. Działa bez przełączania do gry."/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="2 · Wyjście z serwera" HorizontalAlignment="Stretch" Margin="0,0,12,0" Click="BtnProtectionTestDisconnect_Click"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="ESC → Disconnect, dokładnie jak przy alarmie. Bez ponownego wejścia."/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="3 · Wejście na serwer" HorizontalAlignment="Stretch" Margin="0,0,12,0" Click="BtnProtectionTestJoin_Click"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="Pełny reconnect z profilu: menu główne, lista serwerów, Direct Connect, wejście, /home i kontrola EQ."/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="4 · Powrót na home" HorizontalAlignment="Stretch" Margin="0,0,12,0" Click="BtnProtectionTestHome_Click"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="Sama komenda home z profilu (z wyborem w GUI, jeśli ustawiony) i odczekanie teleportu."/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="5 · Kontrola kilofa (EQ)" HorizontalAlignment="Stretch" Margin="0,0,12,0" Click="BtnProtectionTestPickaxe_Click"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="Otwiera EQ i szuka diamentowego kilofa po znaczniku paczki — tak jak po powrocie na serwer."/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="6 · Brak kilofa → home" HorizontalAlignment="Stretch" Margin="0,0,12,0" Click="BtnProtectionTestMissingPickaxe_Click"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="Reakcja na brak kilofa: powrót na home i zakończenie kopania (jeśli trwało)."/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="7 · Nasłuch bez reakcji" HorizontalAlignment="Stretch" Margin="0,0,12,0" Click="BtnProtectionTestSound_Click"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="15 s nasłuchu: daj się uderzyć — Kopacz tylko pokaże, że rozpoznał dźwięk, i wyśle test na Discord."/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="8 · Nasłuch z reakcją (30 s)" HorizontalAlignment="Stretch" Margin="0,0,12,0" Click="BtnProtectionTestLiveSound_Click"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="Prawdziwe uderzenie uruchamia pełną reakcję — także bez kopania i mimo zaznaczonego trybu testowego."/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="9 · Pełny alarm (symulacja)" HorizontalAlignment="Stretch" Margin="0,0,12,0" Click="BtnProtectionTestAlarm_Click"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="Cały łańcuch ochrony bez dźwięku, według trybu po alarmie: zatrzymanie, wyjście, odczekanie, wejście, kilof, home i wznowienie — albo tylko wyjście."/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Content="10 · Pełny cykl z kopaniem" Style="{StaticResource GlassPrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,12,0" Click="BtnProtectionTestFullCycle_Click"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource GlassSub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="Wyjście z serwera → odczekanie jak po alarmie → reconnect (menu, lista, wejście, /home, kontrola EQ) → start kopania tym kanałem, który kopał albo ruszyłby START."/>
                                            </Grid>
                                            <Border Style="{StaticResource GlassInset}" Margin="0,0,0,18">
                                                <TextBlock Name="TxtProtectionTestStatus" Text="Gotowe. Zacznij od kroku 1 i idź po kolei." Style="{StaticResource GlassSub}" TextWrapping="Wrap"/>
                                            </Border>

                                            <!-- Pozostałe testy -->
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="EKWIPUNEK I ZŁOTO" Style="{StaticResource GlassCaption}" Margin="0,0,0,8"/>
                                                    <WrapPanel Margin="0,0,0,6">
                                                        <Button Content="Test Auto EQ" Margin="0,0,8,8" Click="BtnInventoryCleanupTest_Click" ToolTip="Jednorazowy skan i porządkowanie EQ z bieżącymi ustawieniami (jak przycisk w zakładce Ekwipunek)."/>
                                                        <Button Content="Test odczytu menu złota" Margin="0,0,8,8" Click="BtnGoldDepositTest_Click" ToolTip="Otwiera menu banku/bazaru i sprawdza układ — bez wpłaty."/>
                                                        <Button Content="Test wpłaty złota" Margin="0,0,8,8" Click="BtnGoldDepositRunTest_Click" ToolTip="Pełna wpłata złota z ekwipunku — z małą ilością złota."/>
                                                        <Button Content="STOP testu złota" Style="{StaticResource GlassDangerButton}" Margin="0,0,8,8" Click="BtnGoldDepositStopTest_Click"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="DISCORD" Style="{StaticResource GlassCaption}" Margin="0,4,0,8"/>
                                                    <WrapPanel>
                                                        <Button Content="Wyślij test" Margin="0,0,8,8" Click="BtnDiscordTest_Click" ToolTip="Jedna wiadomość: sprawdza token, kanał i uprawnienia bota."/>
                                                        <Button Content="Testuj powiadomienia" Margin="0,0,8,8" Click="BtnDiscordTestNotifications_Click" ToolTip="Przykład każdego włączonego powiadomienia, z oznaczeniem i zrzutem."/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="PACZKA ZASOBÓW" Style="{StaticResource GlassCaption}" Margin="0,0,0,8"/>
                                                    <WrapPanel Margin="0,0,0,6">
                                                        <Button Content="Utwórz paczkę ponownie" Margin="0,0,8,8" Click="BtnResourcePackCreate_Click" ToolTip="Buduje paczkę od nowa z plików gry i zastępuje poprzednią w resourcepacks."/>
                                                        <Button Content="Otwórz folder resourcepacks" Margin="0,0,8,8" Click="BtnResourcePackOpenFolder_Click"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="DIAGNOSTYKA" Style="{StaticResource GlassCaption}" Margin="0,4,0,8"/>
                                                    <WrapPanel>
                                                        <Button Content="Konsola zdarzeń" Margin="0,0,8,8" Click="BtnLogConsole_Click"/>
                                                        <Button Content="Wyczyść wyniki" Margin="0,0,8,8" Click="BtnDeveloperClearLog_Click" ToolTip="Czyści tylko podgląd wyników powyżej; dziennik app.log zostaje."/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- „Jest więcej poniżej”: widoczny tylko, gdy bieżąca strona ma treść niżej -->
                <Button Name="BtnScrollMore" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Height="32" Padding="14,0" FontSize="12"
                        Visibility="Collapsed" Opacity="0.94" ToolTip="Przewiń w dół" AutomationProperties.Name="Więcej poniżej" Click="BtnScrollMore_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.4" Data="M6,9 L12,15 L18,9"/></Grid></Viewbox>
                        <TextBlock Text="Więcej poniżej" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Pasek stanu -->
                <Border Grid.Row="2" Margin="4,10,8,0" Padding="16,9" CornerRadius="14" Background="#8CFFFFFF" BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                    <TextBlock Name="TxtStatusBar" Text="Gotowy" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GlassOkBrush}" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
