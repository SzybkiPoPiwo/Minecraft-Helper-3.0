                                            </Button>
                                            <Border Grid.Column="4" Style="{StaticResource GlassInset}" VerticalAlignment="Bottom" Padding="12,8">
                                                <TextBlock Name="TxtInventoryCleanupStatus" Text="Gotowe do testu." Style="{StaticResource GlassSub}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Co ustawić w grze przed Auto EQ: duża instrukcja zamiast małych znaczków -->
                                        <Border Style="{StaticResource GlassInset}" Padding="18,16" CornerRadius="18" Margin="0,16,0,0">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Viewbox DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.2" Data="{StaticResource IcoInfo}"/></Grid></Viewbox>
                                                    <TextBlock Text="Ustaw w Minecraft przed włączeniem Auto EQ" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock Text="Auto EQ rozpoznaje przedmioty po znacznikach z paczki — bez tych czterech ustawień nie znajdzie ekwipunku albo kliknie w złe miejsca." Style="{StaticResource GlassSub}" FontSize="12.5" TextWrapping="Wrap" Margin="30,0,0,14"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GlassStepNo}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,2,0,0">
