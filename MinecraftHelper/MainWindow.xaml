                                <Border Name="BorderInventoryCleanupSection" Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource GlassIconTile}" Width="40" Height="40" CornerRadius="13">
