<Window x:Class="MinecraftHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinecraftHelper"
        mc:Ignorable="d"
        Title="Minecraft Helper"
        Width="1280"
        Height="820"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Icon="Assets/miner.ico"
        Background="{DynamicResource GlassBackdropBrush}"
        Foreground="{DynamicResource GlassInkBrush}"
        FontFamily="{DynamicResource GlassFont}"
        FontSize="13">

    <Window.Resources>
        <!-- Ikony liniowe 24×24 (styl canvy Kopacz Glass). Zasoby są samodzielne — bez odwołań do motywu. -->
        <Geometry x:Key="IcoAccounts">M12.5,8 A3.5,3.5 0 1 1 5.5,8 A3.5,3.5 0 1 1 12.5,8 Z M2.5,20 A6.5,6.5 0 0 1 15.5,20 M16,4.5 A3.5,3.5 0 0 1 16,11.5 M18.5,20 A6.5,6.5 0 0 0 15.5,14.5</Geometry>
        <Geometry x:Key="IcoLogs">M9,6 H20 M9,12 H20 M9,18 H20 M4.5,6 H4.51 M4.5,12 H4.51 M4.5,18 H4.51</Geometry>
        <Geometry x:Key="IcoPickaxe">M7,4.5 C12,3 18.5,6 19.5,17 M14.5,9.5 L4,20</Geometry>
        <Geometry x:Key="IcoEye">M2,12 C2,12 5.5,5 12,5 C18.5,5 22,12 22,12 C22,12 18.5,19 12,19 C5.5,19 2,12 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z</Geometry>
        <Geometry x:Key="IcoGrid">M6.5,3.5 H17.5 A3,3 0 0 1 20.5,6.5 V17.5 A3,3 0 0 1 17.5,20.5 H6.5 A3,3 0 0 1 3.5,17.5 V6.5 A3,3 0 0 1 6.5,3.5 Z M3.5,9.2 H20.5 M3.5,14.8 H20.5 M9.2,3.5 V20.5 M14.8,3.5 V20.5</Geometry>
        <Geometry x:Key="IcoShield">M12,3 L4.5,6 V11.5 C4.5,16.1 7.7,19.7 12,21 C16.3,19.7 19.5,16.1 19.5,11.5 V6 Z</Geometry>
        <Geometry x:Key="IcoWindows">M5,8 H14 A2,2 0 0 1 16,10 V17 A2,2 0 0 1 14,19 H5 A2,2 0 0 1 3,17 V10 A2,2 0 0 1 5,8 Z M8,8 V6 A2,2 0 0 1 10,4 H19 A2,2 0 0 1 21,6 V13 A2,2 0 0 1 19,15 H16</Geometry>
        <Geometry x:Key="IcoFlask">M9,3 H15 M10,3 V9.5 L4.8,18.6 A1.6,1.6 0 0 0 6.2,21 H17.8 A1.6,1.6 0 0 0 19.2,18.6 L14,9.5 V3</Geometry>
        <Geometry x:Key="IcoSliders">M4,6 H13 M17,6 H20 M4,12 H7 M11,12 H20 M4,18 H15 M19,18 H20 M17,6 A2,2 0 1 1 13,6 A2,2 0 1 1 17,6 Z M11,12 A2,2 0 1 1 7,12 A2,2 0 1 1 11,12 Z M19,18 A2,2 0 1 1 15,18 A2,2 0 1 1 19,18 Z</Geometry>
        <Geometry x:Key="IcoCheck">M5,12.5 L9.5,17 L19,7.5</Geometry>
        <Geometry x:Key="IcoInfo">M12,3 A9,9 0 1 1 11.99,3 Z M12,11 V16 M12,8 H12.01</Geometry>
        <Geometry x:Key="IcoRefresh">M20,11 A8,8 0 1 0 17.7,16.7 M20,5 V11 H14</Geometry>
        <Geometry x:Key="IcoPlus">M12,5 V19 M5,12 H19</Geometry>
        <Geometry x:Key="IcoTrash">M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7</Geometry>
        <Geometry x:Key="IcoGold">M4,15 H11 L13,19 H2 Z M13,15 H20 L22,19 H11 Z M8.5,10 H15.5 L17.5,14 H6.5 Z</Geometry>
        <Geometry x:Key="IcoEar">M11,5 L6,9 H3 V15 H6 L11,19 Z M15.5,8.5 A5,5 0 0 1 15.5,15.5 M18.5,5.5 A9,9 0 0 1 18.5,18.5</Geometry>
        <Geometry x:Key="IcoFish">M3,12 C6,7 12,6 16,9 L21,6 V18 L16,15 C12,18 6,17 3,12 Z M8,11 H8.01</Geometry>
        <Geometry x:Key="IcoMonitor">M4,5 H20 A1,1 0 0 1 21,6 V15 A1,1 0 0 1 20,16 H4 A1,1 0 0 1 3,15 V6 A1,1 0 0 1 4,5 Z M8,20 H16 M12,16 V20</Geometry>
        <Geometry x:Key="IcoPalette">M12,3 A9,9 0 1 0 12,21 C13.5,21 14,20 14,19 C14,17.5 15,17 16,17 H18 A3,3 0 0 0 21,14 C21,8 17,3 12,3 Z M7.5,11.5 H7.51 M10.5,7.5 H10.51 M15.5,8 H15.51</Geometry>
        <Geometry x:Key="IcoKeyboard">M4.5,6 H19.5 A2,2 0 0 1 21.5,8 V16 A2,2 0 0 1 19.5,18 H4.5 A2,2 0 0 1 2.5,16 V8 A2,2 0 0 1 4.5,6 Z M6.5,10 H6.51 M10,10 H10.01 M13.5,10 H13.51 M17,10 H17.01 M7.5,14 H16.5</Geometry>
        <Geometry x:Key="IcoUser">M16,8 A4,4 0 1 1 8,8 A4,4 0 1 1 16,8 Z M4,21 A8,8 0 0 1 20,21</Geometry>
        <Geometry x:Key="IcoTransfer">M12,3 V15 M7,10 L12,15 L17,10 M5,20 H19</Geometry>
        <Geometry x:Key="IcoSignal">M4.5,12.5 A8,8 0 0 1 19.5,12.5 M8,12.5 A4,4 0 0 1 16,12.5 M12,13 V20</Geometry>
        <Geometry x:Key="IcoPlay">M8,5 L19,12 L8,19 Z</Geometry>
        <Geometry x:Key="IcoStopSquare">M7,7 H17 V17 H7 Z</Geometry>
        <Geometry x:Key="IcoSearch">M17,11 A6,6 0 1 1 5,11 A6,6 0 1 1 17,11 Z M15.5,15.5 L20,20</Geometry>
        <Geometry x:Key="IcoArrowRight">M5,12 H19 M13,6 L19,12 L13,18</Geometry>
        <Geometry x:Key="IcoBox">M12,3 L20,7.5 V16.5 L12,21 L4,16.5 V7.5 Z M4,7.5 L12,12 L20,7.5 M12,12 V21</Geometry>
        <Geometry x:Key="IcoFood">M7,3 V11 M4,3 V8 A3,3 0 0 0 10,8 V3 M7,11 V21 M17,3 C15,3 14,6 14,10 C14,12 15,13 17,13 V21</Geometry>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#161A2B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#4F566B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ReqItem" TargetType="Border">
            <Setter Property="Background" Value="#80FFFFFF"/>
            <Setter Property="BorderBrush" Value="#17161A2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="PipeBadge" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="BorderBrush" Value="#17161A2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="FacingBox" TargetType="Border">
            <Setter Property="Background" Value="#99FFFFFF"/>
            <Setter Property="BorderBrush" Value="#17161A2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
        <Style x:Key="HotbarSlot" TargetType="Border">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#0F161A2B"/>
            <Setter Property="BorderBrush" Value="#12161A2B"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <local:GlassBlobBackground x:Name="CyberBackground" IsAnimationEnabled="True"/>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= PASEK BOCZNY ================= -->
            <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="12,16,12,14" Margin="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="6,0,6,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="14" Background="{DynamicResource GlassAccentBrush}" TextElement.Foreground="White">
                            <Viewbox Width="21" Height="21"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.3" Data="{StaticResource IcoPickaxe}"/></Grid></Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Kopacz" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Name="TxtAppVersion" Text="Minecraft Helper" FontSize="11.5" Foreground="{StaticResource GlassInk2Brush}"/>
                        </StackPanel>
                    </Grid>

                    <Border DockPanel.Dock="Top" Background="#D1FFFFFF" BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="10" Margin="0,0,0,14"
                            Cursor="Hand" ToolTip="Zmień konto" MouseLeftButtonUp="AccountChip_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource GlassAccentBrush}">
                                <TextBlock Name="TxtAccountInitial" Text="G" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Name="TxtAccountName" Text="Główne" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Name="TxtCurrentWindowTitle" Text="Brak" FontSize="11" Foreground="{StaticResource GlassInk2Brush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Border Height="1" Background="{StaticResource GlassLineBrush}" Margin="6,0,6,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,6">
                                    <Ellipse Name="EllMinecraftFocus" Width="7" Height="7" Fill="{StaticResource GlassBadBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Text="Fokus gry:" FontSize="12" Foreground="{StaticResource GlassInk2Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Name="TxtMinecraftFocus" Text="✗ Nie" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <Ellipse Name="EllSettingsSaved" Width="7" Height="7" Fill="{StaticResource GlassOkBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Text="Zapisano:" FontSize="12" Foreground="{StaticResource GlassInk2Brush}" Margin="0,0,5,0"/>
                                    <TextBlock Name="TxtSettingsSaved" Text="✓ Tak" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Konsola zdarzeń: mała, ale zawsze pod ręką; plakietka = nowe błędy od ostatniego otwarcia -->
                            <Button Name="BtnLogConsole" Grid.Column="1" Style="{StaticResource GlassIconButton}" Width="34" Height="34" Margin="0,0,6,0" VerticalAlignment="Center"
                                    ToolTip="Konsola zdarzeń — co się dzieje w programie (logi)" AutomationProperties.Name="Konsola zdarzeń" Click="BtnLogConsole_Click">
                                <Grid Width="24" Height="24">
                                    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M4,6.5 L9,11.5 L4,16.5 M11,17.5 H20"/></Grid></Viewbox>
                                    <Border Name="BadgeLogErrors" Visibility="Collapsed" Background="{StaticResource GlassBadBrush}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0">
                                        <TextBlock Name="TxtLogErrorsCount" Text="1" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="WSZYSTKIE KONTA" Style="{StaticResource GlassCaption}" Margin="12,0,0,4"/>
                            <RadioButton Name="NavAccounts" Style="{StaticResource GlassNavItem}" Tag="TabAccounts" Checked="NavItem_Checked" AutomationProperties.Name="Konta">
                                <DockPanel>
                                    <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassNavIconPath}" Data="{StaticResource IcoAccounts}"/></Grid></Viewbox>
                                    <TextBlock Text="Konta" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Name="NavLogs" Style="{StaticResource GlassNavItem}" Tag="TabLogs" Checked="NavItem_Checked" AutomationProperties.Name="Logi">
                                <DockPanel>
                                    <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassNavIconPath}" Data="{StaticResource IcoLogs}"/></Grid></Viewbox>
                                    <TextBlock Text="Logi" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>

                            <TextBlock Text="WYBRANE KONTO" Style="{StaticResource GlassCaption}" Margin="12,14,0,4"/>
                            <RadioButton Name="NavKopacz" Style="{StaticResource GlassNavItem}" Tag="TabKopacz" Checked="NavItem_Checked" AutomationProperties.Name="Kopanie">
                                <DockPanel>
                                    <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassNavIconPath}" Data="{StaticResource IcoPickaxe}"/></Grid></Viewbox>
                                    <TextBlock Text="Kopanie" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Name="NavInventory" Style="{StaticResource GlassNavItem}" Tag="TabInventory" Checked="NavItem_Checked" AutomationProperties.Name="Ekwipunek">
                                <DockPanel>
                                    <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassNavIconPath}" Data="{StaticResource IcoGrid}"/></Grid></Viewbox>
                                    <TextBlock Text="Ekwipunek" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Name="NavProtection" Style="{StaticResource GlassNavItem}" Tag="TabProtection" Checked="NavItem_Checked" AutomationProperties.Name="Ochrona">
                                <DockPanel>
                                    <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassNavIconPath}" Data="{StaticResource IcoShield}"/></Grid></Viewbox>
                                    <TextBlock Text="Ochrona" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Name="NavBackground" Style="{StaticResource GlassNavItem}" Tag="TabBackground" Checked="NavItem_Checked" AutomationProperties.Name="Okno gry">
                                <DockPanel>
                                    <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassNavIconPath}" Data="{StaticResource IcoWindows}"/></Grid></Viewbox>
                                    <TextBlock Text="Okno gry" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton Name="NavTools" Style="{StaticResource GlassNavItem}" Tag="TabTools" Checked="NavItem_Checked" AutomationProperties.Name="Narzędzia (beta)">
                                <DockPanel>
                                    <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassNavIconPath}" Data="{StaticResource IcoFlask}"/></Grid></Viewbox>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource GlassPill}" Background="{StaticResource GlassWarnSoftBrush}" Height="20" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="BETA" FontSize="10" Foreground="{StaticResource GlassWarnBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Narzędzia" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>

                            <Border Height="1" Background="{StaticResource GlassLineBrush}" Margin="6,10,6,10"/>
                            <RadioButton Name="NavSettings" Style="{StaticResource GlassNavItem}" Tag="TabSettings" Checked="NavItem_Checked" AutomationProperties.Name="Ustawienia">
                                <DockPanel>
                                    <Viewbox Width="20" Height="20" Margin="0,0,12,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassNavIconPath}" Data="{StaticResource IcoSliders}"/></Grid></Viewbox>
                                    <TextBlock Text="Ustawienia" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ================= TREŚĆ ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Pasek wybranego konta: ten sam na każdej zakładce konta (ukryty w Kontach i Logach) -->
                <Border Name="BorderAccountBar" Style="{StaticResource GlassCard}" CornerRadius="22" Padding="16,12" Margin="4,0,8,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="15" Background="{DynamicResource GlassAccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Text, ElementName=TxtAccountInitial}" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Text, ElementName=TxtAccountName}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                <Border Name="PillHeroState" Style="{StaticResource GlassPill}" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Name="DotHeroState" Width="6" Height="6" Fill="{StaticResource GlassInk2Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Name="TxtHeroState" Text="GOTOWY" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Name="TxtHeroTitle" Text="Kopacz czeka na bind" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Name="TxtHeroHint" Text="Włącz tryb i naciśnij jego bind w grze." Style="{StaticResource GlassSub}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="Czas sesji" Style="{StaticResource GlassSub}" HorizontalAlignment="Right"/>
                            <TextBlock Name="TxtHeroClock" Text="0:00:00" FontFamily="{StaticResource GlassMonoFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="BtnAccountPeek" Height="42" Padding="14,0" ToolTip="Podgląd okna gry tego konta w osobnym oknie" Click="BtnAccountPeek_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="17" Height="17" Margin="0,0,8,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="{StaticResource IcoEye}"/></Grid></Viewbox>
                                    <TextBlock Text="Podgląd"/>
                                </StackPanel>
                            </Button>
                            <Button Name="BtnCalibrateWindow" Height="42" Padding="14,0" Margin="8,0,0,0" ToolTip="Ustawia okno Minecrafta tego konta (854×480) obok okien pozostałych kont." Click="BtnCalibrateWindow_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="17" Height="17" Margin="0,0,8,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M4,8 V4 H8 M16,4 H20 V8 M20,16 V20 H16 M8,20 H4 V16 M9,12 H15 M12,9 V15"/></Grid></Viewbox>
                                    <TextBlock Text="Kalibruj okno"/>
                                </StackPanel>
                            </Button>
                            <Button Name="BtnHeroToggle" AutomationProperties.Name="Start lub stop kopania" Style="{StaticResource GlassPrimaryButton}" MinWidth="112" Height="42" FontSize="14" Margin="8,0,0,0" Click="BtnHeroToggle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0"><Grid Width="24" Height="24"><Path Name="PathHeroToggle" Fill="White" Data="{StaticResource IcoPlay}"/></Grid></Viewbox>
                                    <TextBlock Name="TxtHeroToggle" Text="START"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <!-- Nagłówki są w pasku bocznym; ukryty host zostawia zakładki w drzewie dostępności. -->
                                <TabPanel IsItemsHost="True" Visibility="Collapsed"/>
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- ========== KONTA ========== -->
                    <TabItem Name="TabAccounts" Header="Konta">
                        <ContentControl Name="HostAccounts"/>
                    </TabItem>

                    <!-- ========== LOGI ========== -->
                    <TabItem Name="TabLogs" Header="Logi">
                        <ContentControl Name="HostLogs"/>
                    </TabItem>

                    <!-- ========== KOPACZ ========== -->
                    <TabItem Name="TabKopacz" Header="Kopanie">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,2,8,12">
                                <StackPanel Margin="4,4,4,18">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Kopanie" Style="{StaticResource GlassH1}"/>
                                    </StackPanel>
                                    <TextBlock Text="Tryb, bind w grze i komendy w pętli tego konta. Bind uruchamia i natychmiast zatrzymuje wybrany tryb." Style="{StaticResource GlassLead}"/>
                                </StackPanel>

                                <!-- Kanały kopania -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Name="BorderKopacz533Section" Style="{StaticResource GlassCard}" CornerRadius="24" Padding="22,20" Margin="0,0,0,18" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource GlassIconTile}" Width="40" Height="40" CornerRadius="13">
