<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MinecraftHelper.Miner</AssemblyName>
    <Product>Minecraft Helper Kopacz</Product>
    <DefineConstants>$(DefineConstants);MINER_EDITION</DefineConstants>
    <ApplicationIcon>Assets\miner.ico</ApplicationIcon>
    <Version>3.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <InformationalVersion>3.0-miner</InformationalVersion>
    <Copyright>Copyright © 2026 SzybkiPoPiwo — GNU GPL 3.0</Copyright>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**;bin_codex\**;obj_codex\**;bin_tmp\**;obj_codex_verify\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\miner.ico" />
    <Resource Include="Assets\miner.png" />
    <Content Include="Assets\miner.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sounds\Damage\*.ogg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Paczkę zasobów buduje sam Kopacz (MarkerResourcePack) — ikona i dźwięki obrażeń są w programie. -->
    <EmbeddedResource Include="Assets\pack.png" LogicalName="MinecraftHelper.ResourcePack.pack.png" />
    <EmbeddedResource Include="Assets\Sounds\Damage\*.ogg" LogicalName="MinecraftHelper.ResourcePack.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Data.English" Version="4.0.0" />
  </ItemGroup>

  <!-- Tesseract ships native binaries for both architectures. The x64 build
       never loads x86 DLLs; exclude them before publishing/bundling. -->
  <Target Name="ExcludeX86OcrFromX64Publish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                            Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('x86/'))" />
    </ItemGroup>
  </Target>

</Project>
