<Window x:Class="MinecraftHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinecraftHelper"
        Title="Minecraft Helper Auto Clicker"
        Width="520"
        Height="760"
        MinWidth="460"
        MinHeight="560"
        Icon="Assets/autoclicker.ico"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource GlassBackdropBrush}"
        Foreground="{StaticResource GlassInkBrush}"
        FontFamily="{StaticResource GlassFont}"
        FontSize="12.5">
    <Window.Resources>
        <!-- Kafelek ikony karty szarzeje, gdy moduł jest wyłączony. -->
        <Style x:Key="ModuleIconTile" TargetType="Border" BasedOn="{StaticResource GlassIconTile}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.IsChecked, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Background" Value="{StaticResource GlassNeutralSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource GlassInk2Brush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HotbarSlotButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="9" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource GlassLabel}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Grid Grid.Row="0" Margin="14,14,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource GlassAccentBrush}" TextElement.Foreground="White">
                <Viewbox Width="19" Height="19"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.2" Data="M12,3 A6,6 0 0 1 18,9 V15 A6,6 0 0 1 6,15 V9 A6,6 0 0 1 12,3 Z M12,7 V11"/></Grid></Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="Auto Clicker" Style="{StaticResource GlassTitle}"/>
                <TextBlock Name="TxtAppVersion" Text="Minecraft Helper" FontSize="11" Foreground="{StaticResource GlassInk2Brush}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GlassChipButton}" Click="BtnWindowChip_Click" ToolTip="Wybór okna Minecrafta">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Name="FocusDot" Width="7" Height="7" Fill="{StaticResource GlassBadBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtFocus" Text="Minecraft: brak" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <TabControl Name="MainTabs" Grid.Row="1">
            <!-- ===== Clicker ===== -->
            <TabItem Header="Clicker">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,2">
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ModuleIconTile}" Tag="{Binding ElementName=ChkAutoLeftEnabled}">
                                        <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M12,3 A6,6 0 0 1 18,9 V15 A6,6 0 0 1 6,15 V9 A6,6 0 0 1 12,3 Z M12,3 V11 H6 V9 A6,6 0 0 1 12,3 Z"/></Grid></Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="AUTO LPM" Style="{StaticResource GlassH2}"/>
                                            <Border Name="PillAutoLeftState" Style="{StaticResource GlassPill}" Margin="7,0,0,0">
                                                <TextBlock Name="TxtAutoLeftState" Text="OFF" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoToolTipStyle}"
                                                             Content="AUTO LPM automatycznie klika lewym przyciskiem myszy w ustawionym zakresie CPS.&#10;&#10;PRZEŁĄCZANIE BINDEM: jedno naciśnięcie włącza, następne wyłącza.&#10;TRZYMANIE BINDU: klika wyłącznie podczas fizycznego trzymania przypisanego klawisza.&#10;BIND + FIZYCZNY LPM: bind i LPM trzeba nacisnąć razem; puszczenie LPM wyłącza clicker.&#10;AKTYWACJA BINDEM + TRZYMANIE LPM: bind przełącza gotowość, a każde późniejsze trzymanie LPM uruchamia ustawione CPS. Puszczenie LPM zatrzymuje kliknięcia, ale tryb pozostaje gotowy aż do ponownego naciśnięcia binda.&#10;&#10;CPS „od–do” ustawia losowany zakres; wpisanie tej samej wartości daje stały CPS. Tryb DAB dodatkowo przytrzymuje klawisz O wyłącznie podczas faktycznego klikania AUTO LPM. Moduł działa tylko w zapisanym, aktywnym oknie Minecrafta."/>
                                                </Button.ToolTip>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Name="TxtAutoLeftSummary" Text="Wyłączony" Style="{StaticResource GlassSub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox Name="ChkAutoLeftEnabled" Grid.Column="2" ToolTip="Włącz AUTO LPM" AutomationProperties.Name="Włącz AUTO LPM" Checked="ChkAutoLeftEnabled_Changed" Unchecked="ChkAutoLeftEnabled_Changed"/>
                                </Grid>
                                <StackPanel Name="PanelAutoLeftContent" Margin="0,14,0,0">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Bind" Style="{StaticResource GlassLabel}"/>
                                            <Border Style="{StaticResource GlassBindField}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GlassMiniIconButton}" ToolTip="Usuń bind" Click="BtnClearBind_Click" Tag="AutoLeft">
                                                        <Viewbox Width="15" Height="15"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7"/></Grid></Viewbox>
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource GlassBindSaveButton}" Click="BtnSaveBind_Click" Tag="AutoLeft"/>
                                                    <TextBox Name="TxtAutoLeftKey" PreviewMouseLeftButtonDown="BindBox_PreviewMouseLeftButtonDown" Tag="AutoLeft" Style="{StaticResource GlassKeyCap}"/>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tryb" Style="{StaticResource GlassLabel}"/>
                                            <ComboBox Name="CbAutoLeftMode" SelectionChanged="RuntimeSetting_Changed"
                                                      ToolTip="Przełączanie: bind włącza/wyłącza ciągłe klikanie. Trzymanie: działa podczas trzymania bindu. Kombinacja: bind i LPM uruchamiają jedną sesję do puszczenia LPM. Aktywacja + LPM: bind uzbraja tryb, a fizyczny LPM uruchamia i zatrzymuje kliknięcia bez rozbrajania.">
                                                <ComboBoxItem Content="Przełączanie bindem" Tag="Toggle"/>
                                                <ComboBoxItem Content="Działa podczas trzymania bindu" Tag="Hold"/>
                                                <ComboBoxItem Content="Bind + fizyczny LPM" Tag="Combo"/>
                                                <ComboBoxItem Content="Aktywacja bindem + trzymanie LPM" Tag="PhysicalToggle"/>
                                                <ComboBoxItem Content="Podwójne kliknięcie" Tag="DoubleClick"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Name="TxtAutoLeftModeHint" Style="{StaticResource GlassSub}" Margin="0,-4,0,12"/>
                                    <StackPanel Name="PanelAutoLeftDoubleClick" Margin="0,0,0,12">
                                        <Border Style="{StaticResource GlassInset}" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Drugie kliknięcie po" Style="{StaticResource GlassOptionTitle}" VerticalAlignment="Center"/>
                                                <Slider Name="SliderAutoLeftDoubleClickMs" Grid.Column="1" Minimum="0" Maximum="200" Value="50" SmallChange="5" LargeChange="25" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Drugie kliknięcie po" ValueChanged="PvpExtrasSlider_ValueChanged"/>
                                                <TextBlock Name="TxtAutoLeftDoubleClickMs" Grid.Column="2" Text="50 ms" FontFamily="{StaticResource GlassMonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource GlassAccentInkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Name="TxtAutoLeftDoubleClickFlow" Text="Twój LPM → 50 ms → drugi LPM, trzymany razem z Twoim." Style="{StaticResource GlassSub}" Margin="2,6,0,0"/>
                                    </StackPanel>
                                    <Grid Name="PanelAutoLeftCps" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="CPS od" Style="{StaticResource GlassLabel}"/>
                                            <TextBox Name="TxtAutoLeftMinCps" Text="10" Style="{StaticResource GlassMonoBox}" TextChanged="RuntimeText_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="do" Style="{StaticResource GlassLabel}"/>
                                            <TextBox Name="TxtAutoLeftMaxCps" Text="12" Style="{StaticResource GlassMonoBox}" TextChanged="RuntimeText_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                            <local:GlassRangeSlider x:Name="SliderAutoLeftCps" Minimum="1" Maximum="20" AutomationProperties.Name="Zakres CPS LPM" RangeChanged="SliderAutoLeftCps_RangeChanged"/>
                                            <Grid Margin="9,2,9,0" TextElement.FontSize="10" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource GlassInk2Brush}">
                                                <TextBlock Text="1" HorizontalAlignment="Left"/>
                                                <TextBlock Name="TxtAutoLeftScaleMid" Text="10" HorizontalAlignment="Center"/>
                                                <TextBlock Name="TxtAutoLeftScaleMax" Text="20" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Name="ChkAutoLeftDabMode" Checked="RuntimeCheck_Changed" Unchecked="RuntimeCheck_Changed">
                                        <StackPanel>
                                            <TextBlock Text="Tryb DAB" Style="{StaticResource GlassOptionTitle}"/>
                                            <TextBlock Text="Podczas klikania AUTO LPM trzyma klawisz O." Style="{StaticResource GlassSub}" FontWeight="Normal"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource GlassInset}" Margin="0,12,0,0" Padding="12,10">
                                        <StackPanel>
                                            <CheckBox Name="ChkAutoLeftJitter" Checked="PvpExtrasCheck_Changed" Unchecked="PvpExtrasCheck_Changed">
                                                <StackPanel>
                                                    <TextBlock Text="Jitter" Style="{StaticResource GlassOptionTitle}"/>
                                                    <TextBlock Text="Po kliknięciu lekko porusza celownikiem." Style="{StaticResource GlassSub}" FontWeight="Normal"/>
                                                </StackPanel>
                                            </CheckBox>
                                            <StackPanel Name="PanelAutoLeftJitter" Margin="0,10,0,0">
                                                <Border Style="{StaticResource GlassInset}" Padding="12,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Szansa" Style="{StaticResource GlassOptionTitle}" VerticalAlignment="Center"/>
                                                        <Slider Name="SliderAutoLeftJitterChance" Grid.Column="1" Minimum="0" Maximum="100" Value="35" SmallChange="5" LargeChange="25" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Szansa" ValueChanged="PvpExtrasSlider_ValueChanged"/>
                                                        <TextBlock Name="TxtAutoLeftJitterChance" Grid.Column="2" Text="35 %" FontFamily="{StaticResource GlassMonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource GlassAccentInkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource GlassInset}" Padding="12,8" Margin="0,6,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Rozrzut" Style="{StaticResource GlassOptionTitle}" VerticalAlignment="Center"/>
                                                        <Slider Name="SliderAutoLeftJitterDispersion" Grid.Column="1" Minimum="1" Maximum="10" Value="2" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Rozrzut" ValueChanged="PvpExtrasSlider_ValueChanged"/>
                                                        <TextBlock Name="TxtAutoLeftJitterDispersion" Grid.Column="2" Text="2 px" FontFamily="{StaticResource GlassMonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource GlassAccentInkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                            <Border Name="DividerAfterJitter" Style="{StaticResource GlassDivider}" Margin="0,10"/>
                                            <CheckBox Name="ChkAutoLeftSneakPause" Checked="PvpExtrasCheck_Changed" Unchecked="PvpExtrasCheck_Changed">
                                                <StackPanel>
                                                    <TextBlock Text="Pauza przy kucaniu" Style="{StaticResource GlassOptionTitle}"/>
                                                    <TextBlock Text="Gdy trzymasz klawisz skradania, AUTO LPM nie klika." Style="{StaticResource GlassSub}" FontWeight="Normal"/>
                                                </StackPanel>
                                            </CheckBox>
                                            <Grid Name="PanelAutoLeftSneak" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Klawisz skradania" Style="{StaticResource GlassOptionTitle}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Style="{StaticResource GlassBindField}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource GlassBindSaveButton}" Click="BtnSaveBind_Click" Tag="SneakKey"/>
                                                        <TextBox Name="TxtAutoLeftSneakKey" PreviewMouseLeftButtonDown="BindBox_PreviewMouseLeftButtonDown" Tag="SneakKey" Style="{StaticResource GlassKeyCap}"/>
                                                    </DockPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ModuleIconTile}" Tag="{Binding ElementName=ChkAutoRightEnabled}">
                                        <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M12,3 A6,6 0 0 1 18,9 V15 A6,6 0 0 1 6,15 V9 A6,6 0 0 1 12,3 Z M12,3 V11 H18 V9 A6,6 0 0 0 12,3 Z"/></Grid></Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="AUTO PPM" Style="{StaticResource GlassH2}"/>
                                            <Border Name="PillAutoRightState" Style="{StaticResource GlassPill}" Margin="7,0,0,0">
                                                <TextBlock Name="TxtAutoRightState" Text="OFF" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoToolTipStyle}"
                                                             Content="AUTO PPM automatycznie klika prawym przyciskiem myszy w ustawionym zakresie CPS.&#10;&#10;PRZEŁĄCZANIE BINDEM: jedno naciśnięcie włącza, następne wyłącza.&#10;TRZYMANIE BINDU: działa tylko podczas trzymania osobnego binda.&#10;BIND + FIZYCZNY PPM: bind i PPM trzeba nacisnąć razem; puszczenie PPM wyłącza clicker.&#10;AKTYWACJA BINDEM + TRZYMANIE PPM: osobny bind przełącza gotowość, a każde późniejsze trzymanie PPM uruchamia ustawione CPS do blokowania/używania przedmiotu. Puszczenie PPM zatrzymuje kliknięcia bez rozbrajania trybu.&#10;&#10;Wspólny bind jest możliwy, gdy LPM ma tryb Trzymanie lub Kombinacja, a PPM tryb Kombinacja. Nowy tryb aktywacji fizycznym przyciskiem wymaga osobnego binda dla LPM i PPM. CPS „od–do” oznacza losowany zakres; równe wartości dają stały CPS."/>
                                                </Button.ToolTip>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Name="TxtAutoRightSummary" Text="Wyłączony" Style="{StaticResource GlassSub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox Name="ChkAutoRightEnabled" Grid.Column="2" ToolTip="Włącz AUTO PPM" AutomationProperties.Name="Włącz AUTO PPM" Checked="ChkAutoRightEnabled_Changed" Unchecked="ChkAutoRightEnabled_Changed"/>
                                </Grid>
                                <StackPanel Name="PanelAutoRightContent" Margin="0,14,0,0">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Bind" Style="{StaticResource GlassLabel}"/>
                                            <Border Style="{StaticResource GlassBindField}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GlassMiniIconButton}" ToolTip="Usuń bind" Click="BtnClearBind_Click" Tag="AutoRight">
                                                        <Viewbox Width="15" Height="15"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7"/></Grid></Viewbox>
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource GlassBindSaveButton}" Click="BtnSaveBind_Click" Tag="AutoRight"/>
                                                    <TextBox Name="TxtAutoRightKey" PreviewMouseLeftButtonDown="BindBox_PreviewMouseLeftButtonDown" Tag="AutoRight" Style="{StaticResource GlassKeyCap}"/>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tryb" Style="{StaticResource GlassLabel}"/>
                                            <ComboBox Name="CbAutoRightMode" SelectionChanged="RuntimeSetting_Changed"
                                                      ToolTip="Przełączanie: bind włącza/wyłącza ciągłe klikanie. Trzymanie: działa podczas trzymania osobnego bindu. Kombinacja: bind i PPM uruchamiają jedną sesję do puszczenia PPM. Aktywacja + PPM: osobny bind uzbraja tryb, a fizyczny PPM uruchamia i zatrzymuje kliknięcia bez rozbrajania.">
                                                <ComboBoxItem Content="Przełączanie bindem" Tag="Toggle"/>
                                                <ComboBoxItem Content="Działa podczas trzymania osobnego bindu" Tag="Hold"/>
                                                <ComboBoxItem Content="Bind + fizyczny PPM" Tag="Combo"/>
                                                <ComboBoxItem Content="Aktywacja bindem + trzymanie PPM" Tag="PhysicalToggle"/>
                                                <ComboBoxItem Content="Podwójne kliknięcie" Tag="DoubleClick"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Name="TxtAutoRightModeHint" Style="{StaticResource GlassSub}" Margin="0,-4,0,12"/>
                                    <StackPanel Name="PanelAutoRightDoubleClick" Margin="0,0,0,12">
                                        <Border Style="{StaticResource GlassInset}" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Drugie kliknięcie po" Style="{StaticResource GlassOptionTitle}" VerticalAlignment="Center"/>
                                                <Slider Name="SliderAutoRightDoubleClickMs" Grid.Column="1" Minimum="0" Maximum="200" Value="50" SmallChange="5" LargeChange="25" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Drugie kliknięcie po" ValueChanged="PvpExtrasSlider_ValueChanged"/>
                                                <TextBlock Name="TxtAutoRightDoubleClickMs" Grid.Column="2" Text="50 ms" FontFamily="{StaticResource GlassMonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource GlassAccentInkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Name="TxtAutoRightDoubleClickFlow" Text="Twój PPM → 50 ms → drugi PPM, trzymany razem z Twoim." Style="{StaticResource GlassSub}" Margin="2,6,0,0"/>
                                    </StackPanel>
                                    <Grid Name="PanelAutoRightCps">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="CPS od" Style="{StaticResource GlassLabel}"/>
                                            <TextBox Name="TxtAutoRightMinCps" Text="10" Style="{StaticResource GlassMonoBox}" TextChanged="RuntimeText_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="do" Style="{StaticResource GlassLabel}"/>
                                            <TextBox Name="TxtAutoRightMaxCps" Text="12" Style="{StaticResource GlassMonoBox}" TextChanged="RuntimeText_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                            <local:GlassRangeSlider x:Name="SliderAutoRightCps" Minimum="1" Maximum="20" AutomationProperties.Name="Zakres CPS PPM" RangeChanged="SliderAutoRightCps_RangeChanged"/>
                                            <Grid Margin="9,2,9,0" TextElement.FontSize="10" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource GlassInk2Brush}">
                                                <TextBlock Text="1" HorizontalAlignment="Left"/>
                                                <TextBlock Name="TxtAutoRightScaleMid" Text="10" HorizontalAlignment="Center"/>
                                                <TextBlock Name="TxtAutoRightScaleMax" Text="20" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassWarnNote}">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Text="Wspólny bind: LPM ustaw na Trzymanie lub Kombinację, a PPM na Kombinację. Tryby z aktywacją i podwójnym kliknięciem wymagają osobnych klawiszy. Blokada kursora i overlay są w Ustawieniach."/>
                                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Akcje PVP ===== -->
            <TabItem Header="Akcje">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,2">
                        <Border Style="{StaticResource GlassNote}">
                            <DockPanel>
                                <Viewbox Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,8,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.2" Data="M12,3 A9,9 0 1 1 11.99,3 Z M12,11 V16 M12,8 H12.01"/></Grid></Viewbox>
                                <Button DockPanel.Dock="Right" Content="?" Style="{StaticResource InfoButtonStyle}" VerticalAlignment="Top">
                                    <Button.ToolTip>
                                        <ToolTip Style="{StaticResource InfoToolTipStyle}"
