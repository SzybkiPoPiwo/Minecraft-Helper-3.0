                                <StackPanel Name="PanelLagSwitchContent" Margin="0,8,0,0">
                                    <Border Style="{StaticResource GlassInset}" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Maks. czas" Style="{StaticResource GlassOptionTitle}" VerticalAlignment="Center"/>
                                            <Slider Name="SliderLagSwitchMaxSeconds" Grid.Column="1" Minimum="1" Maximum="30" Value="10" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Maks. czas" ValueChanged="PvpExtrasSlider_ValueChanged"/>
                                            <TextBlock Name="TxtLagSwitchMaxSeconds" Grid.Column="2" Text="10 s" FontFamily="{StaticResource GlassMonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource GlassAccentInkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Border Name="PillLagSwitch" Style="{StaticResource GlassPill}" Margin="0,0,8,0">
                                            <TextBlock Name="TxtLagSwitchPill" Text="Wymaga zgody administratora" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Name="TxtLagSwitchStatus" Text="okno UAC przy pierwszym użyciu" Style="{StaticResource GlassSub}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock Text="Zamrożenie kończy się też po utracie fokusu gry i przy zamknięciu programu." Style="{StaticResource GlassSub}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassWarnNote}">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Text="Auto Guard i zamrożenie okna mogą zostać wykryte przez antycheat serwera."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Jabłka ===== -->
            <TabItem Header="Jabłka">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,2">
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ModuleIconTile}" Tag="{Binding ElementName=ChkAppleCutterEnabled}">
                                        <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M12 7.5c-3.5-2.5-8.5 0-7.5 5.5S8.5 21 12 20c3.5 1 6.5-1.5 7.5-7S15.5 5 12 7.5z M12 7.5c0-2 1-3.5 3-4.5"/></Grid></Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Ścinanie jabłek" Style="{StaticResource GlassH2}"/>
                                            <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoToolTipStyle}"
                                                             Content="Funkcja pracuje w pętli po uruchomieniu osobnym bindem. Wybiera nożyce, trzyma LPM przez losowy czas z podanego zakresu, przełącza się na liście, klika PPM ze stałą szybkością 40 CPS przez ustawiony czas i wraca do nożyc.&#10;&#10;ZAKRES PRZEŁĄCZENIA określa losową przerwę po zmianie slotu. ZAKRES CIĘCIA ustala czas trzymania LPM, a ZAKRES KŁADZENIA — jak długo wysyłane jest PPM 40 CPS.&#10;&#10;Co ustawioną liczbę pełnych cykli program wybiera slot nożyc i wpisuje komendę naprawy, domyślnie /repair. Ponowne naciśnięcie binda zatrzymuje działanie natychmiast. Utrata fokusu lub wykrycie otwartego GUI także zwalnia oba przyciski myszy i przerywa pętlę."/>
                                                </Button.ToolTip>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Bind uruchamia pętlę, ten sam bind zatrzymuje od razu." Style="{StaticResource GlassSub}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox Name="ChkAppleCutterEnabled" Grid.Column="2" ToolTip="Włącz ścinanie jabłek" AutomationProperties.Name="Włącz ścinanie jabłek" Checked="ChkAppleCutterEnabled_Changed" Unchecked="ChkAppleCutterEnabled_Changed"/>
                                </Grid>

                                <StackPanel Name="PanelAppleCutterExpandableContent" Margin="0,14,0,0">
                                    <StackPanel Name="PanelAppleCutterContent">
                                        <UniformGrid Rows="1" Columns="4" Margin="-3,0,-3,12">
                                            <Border Style="{StaticResource GlassInset}" Margin="3,0" Padding="9,7">
                                                <StackPanel><TextBlock Text="1  Nożyce" FontWeight="Bold" FontSize="12"/><TextBlock Name="TxtAppleStepShears" Text="slot 1" Style="{StaticResource GlassSub}" FontSize="11"/></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource GlassInset}" Margin="3,0" Padding="9,7">
                                                <StackPanel><TextBlock Text="2  Cięcie" FontWeight="Bold" FontSize="12"/><TextBlock Text="trzyma LPM" Style="{StaticResource GlassSub}" FontSize="11"/></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource GlassInset}" Margin="3,0" Padding="9,7">
                                                <StackPanel><TextBlock Text="3  Liście" FontWeight="Bold" FontSize="12"/><TextBlock Name="TxtAppleStepLeaves" Text="slot 2" Style="{StaticResource GlassSub}" FontSize="11"/></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource GlassInset}" Margin="3,0" Padding="9,7">
                                                <StackPanel><TextBlock Text="4  Kładzenie" FontWeight="Bold" FontSize="12"/><TextBlock Text="PPM 40 CPS" Style="{StaticResource GlassSub}" FontSize="11"/></StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="88"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Bind" Style="{StaticResource GlassLabel}"/>
                                                <Border Style="{StaticResource GlassBindField}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource GlassMiniIconButton}" ToolTip="Usuń bind" Click="BtnClearBind_Click" Tag="AppleCutter">
                                                            <Viewbox Width="15" Height="15"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7"/></Grid></Viewbox>
                                                        </Button>
                                                        <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource GlassBindSaveButton}" Click="BtnSaveBind_Click" Tag="AppleCutter"/>
                                                        <TextBox Name="TxtAppleCutterBind" PreviewMouseLeftButtonDown="BindBox_PreviewMouseLeftButtonDown" Tag="AppleCutter" Style="{StaticResource GlassKeyCap}"/>
                                                    </DockPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Nożyce" Style="{StaticResource GlassLabel}"/>
                                                <ComboBox Name="CbAppleCutterShearsSlot" SelectionChanged="AppleCutterConfig_SelectionChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Liście" Style="{StaticResource GlassLabel}"/>
                                                <ComboBox Name="CbAppleCutterLeavesSlot" SelectionChanged="AppleCutterConfig_SelectionChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Losowe czasy (od – do, ms)" Style="{StaticResource GlassLabel}" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="8"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Przełączenie slotu" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBox Name="TxtAppleCutterSwitchMinMs" Grid.Column="1" Text="35" Style="{StaticResource GlassMonoBox}" TextChanged="AppleCutterConfig_TextChanged"/>
                                            <TextBox Name="TxtAppleCutterSwitchMaxMs" Grid.Column="3" Text="55" Style="{StaticResource GlassMonoBox}" TextChanged="AppleCutterConfig_TextChanged"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="8"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Cięcie — LPM" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBox Name="TxtAppleCutterBreakMinMs" Grid.Column="1" Text="90" Style="{StaticResource GlassMonoBox}" TextChanged="AppleCutterConfig_TextChanged"/>
                                            <TextBox Name="TxtAppleCutterBreakMaxMs" Grid.Column="3" Text="140" Style="{StaticResource GlassMonoBox}" TextChanged="AppleCutterConfig_TextChanged"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="8"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Kładzenie — PPM" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBox Name="TxtAppleCutterPlaceMinMs" Grid.Column="1" Text="50" Style="{StaticResource GlassMonoBox}" TextChanged="AppleCutterConfig_TextChanged"/>
                                            <TextBox Name="TxtAppleCutterPlaceMaxMs" Grid.Column="3" Text="90" Style="{StaticResource GlassMonoBox}" TextChanged="AppleCutterConfig_TextChanged"/>
                                        </Grid>
                                        <Border Style="{StaticResource GlassWarnNote}">
                                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Text="Podczas kładzenia program wysyła PPM ze stałą szybkością 40 CPS (jedno kliknięcie co 25 ms)."/>
                                        </Border>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Naprawa co (cykli)" Style="{StaticResource GlassLabel}"/>
                                                <TextBox Name="TxtAppleCutterRepairEvery" Text="40" Style="{StaticResource GlassMonoBox}" TextChanged="AppleCutterConfig_TextChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Komenda" Style="{StaticResource GlassLabel}"/>
                                                <TextBox Name="TxtAppleCutterRepairCommand" Text="/repair" Style="{StaticResource GlassMonoBox}" TextChanged="AppleCutterConfig_TextChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Name="TxtAppleRepairProgress" DockPanel.Dock="Right" Text="0 / 40 cykli" FontFamily="{StaticResource GlassMonoFont}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="Do naprawy" Style="{StaticResource GlassSub}"/>
                                        </DockPanel>
                                        <ProgressBar Name="PrgAppleRepair" Height="6" Minimum="0" Maximum="40" Value="0" Margin="0,0,0,12"/>
                                        <Border Style="{StaticResource GlassInset}">
                                            <TextBlock Name="TxtAppleCutterStatus" Text="Gotowe. Ustaw sloty, czasy i bind." Style="{StaticResource GlassSub}" Foreground="{StaticResource GlassOkBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Bindy ===== -->
            <TabItem Header="Bindy">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,2">
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ModuleIconTile}" Tag="{Binding ElementName=ChkBindyEnabled}">
                                        <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M4.5,6 H19.5 A2,2 0 0 1 21.5,8 V16 A2,2 0 0 1 19.5,18 H4.5 A2,2 0 0 1 2.5,16 V8 A2,2 0 0 1 4.5,6 Z M6.5,10 H6.51 M10,10 H10.01 M13.5,10 H13.51 M17,10 H17.01 M7.5,14 H16.5"/></Grid></Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="BINDY" Style="{StaticResource GlassH2}"/>
                                            <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoToolTipStyle}"
                                                             Content="BINDY wysyłają pod bindem jedną zapisaną komendę na chat Minecrafta. Ustaw Klawisz chatu identycznie jak w sterowaniu gry, np. T albo Enter.&#10;&#10;Przycisk „Dodaj bind i komendę” tworzy nowy wpis z własną nazwą, klawiszem i komendą. Jedno naciśnięcie wykonuje komendę jeden raz. Funkcja nie uruchomi binda podczas pisania na chacie ani przy otwartym ekwipunku lub innym GUI."/>
                                                </Button.ToolTip>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Klawisz w grze wpisuje komendę na czacie." Style="{StaticResource GlassSub}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox Name="ChkBindyEnabled" Grid.Column="2" ToolTip="Włącz BINDY" AutomationProperties.Name="Włącz BINDY" Checked="RuntimeCheck_Changed" Unchecked="RuntimeCheck_Changed"/>
                                </Grid>
                                <DockPanel Margin="0,14,0,12">
                                    <TextBlock Text="Klawisz czatu" Style="{StaticResource GlassOptionTitle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Style="{StaticResource GlassBindField}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource GlassBindSaveButton}" Click="BtnSaveBind_Click" Tag="ChatOpen"/>
                                            <TextBox Name="TxtChatOpenKey" PreviewMouseLeftButtonDown="BindBox_PreviewMouseLeftButtonDown" Tag="ChatOpen" Style="{StaticResource GlassKeyCap}"/>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="nie działa w czacie i GUI" Style="{StaticResource GlassSub}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel Name="PanelBindyCommands"/>
                                <Button Style="{StaticResource GlassPrimaryButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="BtnAddBindy_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.6" Data="M12,5 V19 M5,12 H19"/></Grid></Viewbox>
                                        <TextBlock Text="Dodaj bind i komendę"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Auto zbroja ===== -->
            <TabItem Header="Zbroja">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,2">
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ModuleIconTile}" Tag="{Binding ElementName=ChkAutoArmorEnabled}">
                                        <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M8,3 L4,6 V10 L6,11 V21 H18 V11 L20,10 V6 L16,3 L14,5 H10 Z"/></Grid></Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Auto zbroja" Style="{StaticResource GlassH2}"/>
                                            <Border Name="PillAutoArmorProgress" Style="{StaticResource GlassPill}" Margin="7,0,0,0">
                                                <TextBlock Name="TxtAutoArmorProgress" Text="0/8" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoToolTipStyle}"
                                                             Content="AUTO ZBROJA zamienia aktualnie założony komplet z drugim setem przygotowanym w ekwipunku.&#10;&#10;Dla każdej części kliknij najpierw odpowiedni przycisk, otwórz EQ, najedź na właściwy slot i naciśnij lewy Ctrl. Osobno ustaw 4 pola założonego setu oraz 4 pola drugiego setu — razem 8/8. Następnie zamknij EQ i użyj przypisanego binda.&#10;&#10;Odstęp kliknięć określa szybkość zamiany. Po zmianie rozdzielczości, GUI Scale lub trybu okna wykonaj kalibrację ponownie. Ponowne użycie binda bezpiecznie anuluje operację po dokończeniu bieżącego elementu."/>
                                                </Button.ToolTip>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Bind zamienia założony set na drugi z EQ." Style="{StaticResource GlassSub}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox Name="ChkAutoArmorEnabled" Grid.Column="2" ToolTip="Włącz auto zbroję" AutomationProperties.Name="Włącz auto zbroję" Checked="ChkAutoArmorEnabled_Changed" Unchecked="ChkAutoArmorEnabled_Changed"/>
                                </Grid>
                                <StackPanel Name="PanelAutoArmorExpandableContent" Margin="0,14,0,0">
                                    <StackPanel Name="PanelAutoArmorContent">
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Text="Bind" Style="{StaticResource GlassOptionTitle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Border Style="{StaticResource GlassBindField}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GlassMiniIconButton}" ToolTip="Usuń bind" Click="BtnClearBind_Click" Tag="AutoArmor">
                                                        <Viewbox Width="15" Height="15"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" Data="M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7"/></Grid></Viewbox>
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Content="Zapisz" Style="{StaticResource GlassBindSaveButton}" Click="BtnAutoArmorBind_Click"/>
                                                    <TextBox Name="TxtAutoArmorBind" PreviewMouseLeftButtonDown="BindBox_PreviewMouseLeftButtonDown" Tag="AutoArmor" Style="{StaticResource GlassKeyCap}"/>
                                                </DockPanel>
                                            </Border>
                                            <TextBlock Text="otwórz EQ → zamień 4 → zamknij" Style="{StaticResource GlassSub}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Border Style="{StaticResource GlassNote}">
                                            <DockPanel>
                                                <Viewbox Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,8,0"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.2" Data="M9,11 V5 A2,2 0 0 1 13,5 V11 M13,10 V8 A2,2 0 0 1 17,8 V13 A7,7 0 0 1 10,20 H9 A5,5 0 0 1 4.4,17 L3,14 A2,2 0 0 1 6.5,12 L9,14"/></Grid></Viewbox>
                                                <TextBlock Name="TxtAutoArmorHint" TextWrapping="Wrap" FontSize="11.5" FontWeight="SemiBold" Text="Kliknij część, otwórz EQ, najedź na jej slot i naciśnij lewy Ctrl. Ustaw 4 sloty założonego setu i 4 miejsca drugiego setu."/>
                                            </DockPanel>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="ZAŁOŻONY SET" Style="{StaticResource SectionLabel}"/>
                                                <Button Name="BtnAutoArmorEquippedHelmet" Tag="Equipped:0" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="BtnAutoArmorCalibrationSlot_Click"/>
                                                <Button Name="BtnAutoArmorEquippedChestplate" Tag="Equipped:1" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="BtnAutoArmorCalibrationSlot_Click"/>
                                                <Button Name="BtnAutoArmorEquippedLeggings" Tag="Equipped:2" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="BtnAutoArmorCalibrationSlot_Click"/>
                                                <Button Name="BtnAutoArmorEquippedBoots" Tag="Equipped:3" HorizontalContentAlignment="Left" Click="BtnAutoArmorCalibrationSlot_Click"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="DRUGI SET W EQ" Style="{StaticResource SectionLabel}"/>
                                                <Button Name="BtnAutoArmorInventoryHelmet" Tag="Inventory:0" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="BtnAutoArmorCalibrationSlot_Click"/>
                                                <Button Name="BtnAutoArmorInventoryChestplate" Tag="Inventory:1" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="BtnAutoArmorCalibrationSlot_Click"/>
                                                <Button Name="BtnAutoArmorInventoryLeggings" Tag="Inventory:2" Margin="0,0,0,5" HorizontalContentAlignment="Left" Click="BtnAutoArmorCalibrationSlot_Click"/>
                                                <Button Name="BtnAutoArmorInventoryBoots" Tag="Inventory:3" HorizontalContentAlignment="Left" Click="BtnAutoArmorCalibrationSlot_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Name="PrgAutoArmorCalibration" Height="6" Minimum="0" Maximum="8" Value="0" Margin="0,12,0,0"/>
                                        <DockPanel Margin="0,12,0,12">
                                            <Button Content="Anuluj kalibrację" Click="BtnAutoArmorCancelCalibration_Click"/>
                                            <Button Content="Resetuj pola" Style="{StaticResource GlassTextButton}" Margin="6,0,0,0" Click="BtnAutoArmorResetCalibration_Click"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Odstęp kliknięć" Style="{StaticResource GlassOptionTitle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Name="TxtAutoArmorClickDelayMs" Width="60" Text="45" Style="{StaticResource GlassMonoBox}" TextChanged="AutoArmorConfig_TextChanged"/>
                                                <TextBlock Text="ms" Style="{StaticResource GlassSub}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource GlassInset}">
                                            <TextBlock Name="TxtAutoArmorStatus" Style="{StaticResource GlassSub}" Foreground="{StaticResource GlassOkBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Ustawienia ===== -->
            <TabItem Name="TabSettings" ToolTip="Ustawienia" AutomationProperties.Name="Ustawienia">
                <TabItem.Header>
                    <Viewbox Width="17" Height="17"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2" Data="M4,6 H13 M17,6 H20 M4,12 H7 M11,12 H20 M4,18 H15 M19,18 H20 M17,6 A2,2 0 1 1 13,6 A2,2 0 1 1 17,6 Z M11,12 A2,2 0 1 1 7,12 A2,2 0 1 1 11,12 Z M19,18 A2,2 0 1 1 15,18 A2,2 0 1 1 19,18 Z"/></Grid></Viewbox>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,2">
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Proces Minecrafta" Style="{StaticResource GlassH2}"/>
                                    <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}"
                                                     Content="Uruchom Minecrafta lub BlazingPacka, kliknij Odśwież, wybierz proces gry i kliknij Zapisz. Lista pokazuje tylko gry — nie launcher ani inne programy. Clicker trzyma się procesu, więc działa też na pełnym ekranie, po F11 i Alt+Tab, a utrata fokusu nie kasuje wyboru. Wejście jest wysyłane tylko wtedy, gdy gra jest na wierzchu. Wybór działa też dla BINDY, szybkich akcji, ścinania jabłek i Auto zbroi."/>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Name="CbTargetProcess" DisplayMemberPath="DisplayName"/>
                                    <Button Grid.Column="1" Style="{StaticResource GlassIconButton}" Margin="8,0,0,0" ToolTip="Odśwież listę gier" Click="BtnRefreshProcesses_Click">
                                        <Viewbox Width="16" Height="16"><Grid Width="24" Height="24"><Path Style="{StaticResource GlassIconPath}" StrokeThickness="2.2" Data="M20,11 A8,8 0 1 0 17.7,16.7 M20,5 V11 H14"/></Grid></Viewbox>
                                    </Button>
                                    <Button Grid.Column="2" Content="Zapisz" Style="{StaticResource GlassPrimaryButton}" Margin="8,0,0,0" Click="BtnSaveTarget_Click"/>
                                </Grid>
                                <TextBlock Name="TxtWindowStatus" Text="Nie wybrano procesu Minecrafta" Style="{StaticResource GlassSub}" Margin="0,8,0,0"/>
                                <TextBlock Text="Klika tylko w tej grze i tylko gdy jest na wierzchu." Style="{StaticResource GlassSub}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Bezpieczeństwo i HUD" Style="{StaticResource GlassH2}"/>
                                    <Button Content="?" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}"
                                                     Content="BLOKADA KURSORA zatrzymuje clickery i nie uruchamia bindów, gdy Minecraft pokazuje zwykły kursor — np. w ekwipunku, chacie lub menu. Chroni to przed przypadkowym kliknięciem albo wyrzuceniem przedmiotu.&#10;&#10;MAŁY OVERLAY pokazuje nad grą aktualny stan AUTO LPM, AUTO PPM, szybkich akcji, ścinania jabłek, BINDÓW, Auto zbroi i funkcji przytrzymania. Róg ekranu wybierasz poniżej."/>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <CheckBox Name="ChkPauseWhenCursorVisible" Checked="RuntimeCheck_Changed" Unchecked="RuntimeCheck_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Blokada przy widocznym kursorze" Style="{StaticResource GlassOptionTitle}"/>
                                        <TextBlock Text="Stop clickerów i bindów w EQ, czacie i menu." Style="{StaticResource GlassSub}" FontWeight="Normal"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Name="ChkOverlayEnabled" Margin="0,12,0,0" Checked="RuntimeCheck_Changed" Unchecked="RuntimeCheck_Changed">
                                    <StackPanel>
                                        <TextBlock Text="Overlay aktywnych funkcji" Style="{StaticResource GlassOptionTitle}"/>
                                        <TextBlock Text="Mały panel nad grą." Style="{StaticResource GlassSub}" FontWeight="Normal"/>
                                    </StackPanel>
                                </CheckBox>
                                <Grid Name="PanelOverlayPosition" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Height="84" CornerRadius="10" AutomationProperties.Name="Podgląd położenia overlay">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#78A9E8"/><GradientStop Offset="0.52" Color="#78A9E8"/>
                                                <GradientStop Offset="0.52" Color="#5C8F3E"/><GradientStop Offset="0.64" Color="#5C8F3E"/>
                                                <GradientStop Offset="0.64" Color="#7B5A3A"/><GradientStop Offset="1" Color="#7B5A3A"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border Name="OverlayPreviewChip" Width="78" Margin="6" Padding="5,3" CornerRadius="5" Background="#D9FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="LPM · 11 CPS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource GlassAccentInkBrush}"/>
                                        </Border>
                                    </Border>
                                    <UniformGrid Grid.Column="2" Rows="2" Columns="2" VerticalAlignment="Center" Margin="0,0,-5,-5">
                                        <RadioButton Name="RbOverlayTopLeft" GroupName="OverlayCorner" Style="{StaticResource GlassChoiceRadio}" Tag="TopLeft" Margin="0,0,5,5" HorizontalContentAlignment="Center" Content="Lewy górny" Checked="OverlayCorner_Checked"/>
                                        <RadioButton Name="RbOverlayTopRight" GroupName="OverlayCorner" Style="{StaticResource GlassChoiceRadio}" Tag="TopRight" Margin="0,0,5,5" HorizontalContentAlignment="Center" Content="Prawy górny" Checked="OverlayCorner_Checked"/>
                                        <RadioButton Name="RbOverlayBottomLeft" GroupName="OverlayCorner" Style="{StaticResource GlassChoiceRadio}" Tag="BottomLeft" Margin="0,0,5,5" HorizontalContentAlignment="Center" Content="Lewy dolny" Checked="OverlayCorner_Checked"/>
                                        <RadioButton Name="RbOverlayBottomRight" GroupName="OverlayCorner" Style="{StaticResource GlassChoiceRadio}" Tag="BottomRight" Margin="0,0,5,5" HorizontalContentAlignment="Center" Content="Prawy dolny" Checked="OverlayCorner_Checked"/>
                                    </UniformGrid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton Name="RbAccentKoral" GroupName="GlassAccent" AutomationProperties.Name="Akcent Koral" Style="{StaticResource GlassChoiceRadio}" Tag="koral" Margin="6,0,0,0" Checked="AccentSwatch_Checked">
                                        <StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,7,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Offset="0" Color="#D63A44"/><GradientStop Offset="1" Color="#C2410C"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Koral" VerticalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton Name="RbAccentIris" GroupName="GlassAccent" AutomationProperties.Name="Akcent Iris" Style="{StaticResource GlassChoiceRadio}" Tag="iris" Margin="6,0,0,0" Checked="AccentSwatch_Checked">
                                        <StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,7,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Offset="0" Color="#5458E8"/><GradientStop Offset="1" Color="#7C3AED"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Iris" VerticalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton Name="RbAccentOcean" GroupName="GlassAccent" AutomationProperties.Name="Akcent Ocean" Style="{StaticResource GlassChoiceRadio}" Tag="ocean" Margin="6,0,0,0" Checked="AccentSwatch_Checked">
                                        <StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,7,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Offset="0" Color="#0369A1"/><GradientStop Offset="1" Color="#4F46E5"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Ocean" VerticalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                </StackPanel>
                                <TextBlock Text="Akcent" Style="{StaticResource GlassH2}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>


                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border Name="PillVersion" DockPanel.Dock="Right" Style="{StaticResource GlassPill}">
                                        <TextBlock Name="TxtVersionPill" Text="wersja" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Aktualizacje" Style="{StaticResource GlassH2}"/>
                                </DockPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Sprawdź" Margin="6,0,0,0" Click="BtnCheckUpdates_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Co nowego" Style="{StaticResource GlassTextButton}" Margin="6,0,0,0" Click="BtnWhatsNew_Click"/>
                                    <TextBlock Text="Sprawdza GitHub przy starcie. Tylko zgłasza — nic nie pobiera." Style="{StaticResource GlassSub}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </DockPanel>
                                <Border Style="{StaticResource GlassInset}" Margin="0,10,0,0" Padding="10,8">
                                    <TextBlock Name="TxtSettingsPath" FontFamily="{StaticResource GlassMonoFont}" FontSize="11" Foreground="{StaticResource GlassInk2Brush}" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Style="{StaticResource GlassSub}" Margin="2,10,0,0">
                                    <Run Text="SzybkiPoPiwo ·"/>
                                    <Hyperlink NavigateUri="https://github.com/SzybkiPoPiwo/MinecraftHelper" RequestNavigate="Hyperlink_RequestNavigate">github.com/SzybkiPoPiwo/MinecraftHelper</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassNote}">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Text="Zamknięcie przyciskiem X chowa program do zasobnika — aktywne funkcje dalej działają. Pełne zamknięcie: prawy przycisk na ikonie w zasobniku."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Stopka -->
        <Border Grid.Row="2" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="0,1,0,0" Padding="16,8,16,11" Margin="0,6,0,0">
            <DockPanel>
                <Ellipse Name="StatusDot" Width="7" Height="7" Fill="{StaticResource GlassOkBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Name="TxtStatus" Text="Gotowy" FontSize="11.5" Foreground="{StaticResource GlassOkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
